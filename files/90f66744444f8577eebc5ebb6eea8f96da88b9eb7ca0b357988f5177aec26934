GEN_SIZES = {"1:1": (1024, 1024), "4:3": (1152, 864), "3:4": (864, 1152),
             "16:9": (1280, 720), "9:16": (720, 1280)}

_gen_lock = threading.Lock()
_gen_setup = {"phase": "idle", "progress": 0, "label": "", "error": ""}
_gen_jobs = {}
_gen_queue = queue.Queue()
_gen_worker_started = False


def _http_open(url, start=0, timeout=30):
    headers = {"User-Agent": f"AviensToolbox/{APP_VERSION}"}
    if start:
        headers["Range"] = f"bytes={start}-"
    return urllib.request.urlopen(urllib.request.Request(url, headers=headers), timeout=timeout)


def _download(url, dest, on_progress=None):
    """Laedt nach dest (mit .part-Datei, setzt abgebrochene Downloads fort)."""
    dest.parent.mkdir(parents=True, exist_ok=True)
    part = dest.with_name(dest.name + ".part")
    have = part.stat().st_size if part.exists() else 0
    try:
        resp = _http_open(url, have)
    except urllib.error.HTTPError as e:
        if e.code != 416:
            raise
        part.unlink(missing_ok=True)
        have, resp = 0, _http_open(url)
    with resp:
        if have and resp.status != 206:      # Server kann kein Range -> von vorn
            have = 0
        total = have + int(resp.headers.get("Content-Length") or 0)
        with open(part, "ab" if have else "wb") as fh:
            while True:
                chunk = resp.read(1 << 20)
                if not chunk:
                    break
                fh.write(chunk)
                have += len(chunk)
                if on_progress:
                    on_progress(have, total)
    if total and have < total:
        raise RuntimeError("Download unvollstaendig - bitte erneut versuchen.")
    part.replace(dest)


def _sd_exe():
    """Pfad zum sd-cli-Programm (None, wenn noch nicht installiert)."""
    if not SDCPP_DIR.exists():
        return None
    names = ("sd-cli.exe", "sd.exe") if sys.platform == "win32" else ("sd-cli", "sd")
    for n in names:
        hits = sorted(SDCPP_DIR.rglob(n))
        if hits:
            return hits[0]
    return None


def _gen_missing(model):
    """Bausteine, die fuer ein Modell noch fehlen (eigenes Modell: nur die Engine)."""
    need = ["engine"]
    if model in GEN_MODELS:
        need += GEN_MODELS[model]["parts"].values()
    out = []
    for key in need:
        ok = _sd_exe() is not None if key == "engine" else GEN_PARTS[key]["path"].exists()
        if not ok:
            out.append(key)
    return out


def _gen_setup_run(model):
    try:
        todo = _gen_missing(model)
        grand = sum(GEN_PARTS[k]["size"] for k in todo) or 1
        done_before = 0
        for key in todo:
            part = GEN_PARTS[key]

            def prog(have, total, base=done_before, label=part["label"]):
                with _gen_lock:
                    _gen_setup.update(label=label, progress=min(99, round((base + have) * 100 / grand)))

            prog(0, 0)
            _download(part["url"], part["path"], prog)
            if key == "engine":
                with zipfile.ZipFile(part["path"]) as zf:
                    zf.extractall(SDCPP_DIR)
                part["path"].unlink(missing_ok=True)
                exe = _sd_exe()
                if exe is None:
                    raise RuntimeError("sd-cli wurde im Archiv nicht gefunden.")
                if sys.platform != "win32":
                    exe.chmod(0o755)
            done_before += part["size"]
        with _gen_lock:
            _gen_setup.update(phase="idle", progress=100, label="", error="")
    except Exception as e:
        with _gen_lock:
            _gen_setup.update(phase="error", error=f"Einrichtung fehlgeschlagen: {e}")


def _gen_model_key(value):
    value = str(value or "")
    return value if value in GEN_MODELS or value == "custom" else "klein4"


@app.route("/api/gen/status")
