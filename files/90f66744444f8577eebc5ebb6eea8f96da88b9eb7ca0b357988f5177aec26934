        return jsonify(ok=False, error=str(e)), 400


@app.route("/api/stats")
def stats():
    """Zahlen fuer die Startseite: was liegt tatsaechlich im Ausgabe-Ordner?"""
    now = time.time()
    cats, recent, total, total_bytes = [], [], 0, 0
    for folder, label in CATEGORIES:
        d = OUTPUT / folder
        count = size = 0
        if d.exists():
            for f in d.iterdir():
                if not f.is_file() or f.name.startswith("."):
                    continue
                try:
                    st = f.stat()
                except OSError:
                    continue
                count += 1
                size += st.st_size
                recent.append({
                    "file": f.name,
                    "name": re.sub(r"^[0-9a-f]{8}_", "", f.name),
                    "dir": folder,
                    "size": st.st_size,
                    "age": max(0, int(now - st.st_mtime)),
                })
        cats.append({"dir": folder, "label": label, "count": count, "bytes": size})
        total += count
        total_bytes += size

    recent.sort(key=lambda r: r["age"])
    return jsonify(total=total, bytes=total_bytes, cats=cats, recent=recent[:6])


@app.route("/api/popups")
def popups_list():
    """Listet alle Bilder aus den popups-Ordnern (fuer das DVD-Saver-Gadget)."""
    seen, urls = set(), []
    for d in POPUP_DIRS:
        if not d.exists():
            continue
        for p in sorted(d.iterdir()):
            if p.is_file() and p.suffix.lower() in POPUP_EXTS and p.name not in seen:
                seen.add(p.name)
                urls.append(f"/popups/{p.name}")
    return jsonify(images=urls)


@app.route("/popups/<path:fname>")
def popups_serve(fname):
    """Liefert ein Popup-Bild aus dem ersten passenden popups-Ordner."""
    name = os.path.basename(fname)
    for d in POPUP_DIRS:
        target = (d / name)
        if target.exists() and target.is_file():
            return send_file(str(target))
    abort(404)


# ---------------------------------------------------------------- Playlist
# Musik kommt aus drei Quellen: eigener Ordner "music" neben der .exe (User kann
# MP3s reinziehen), Update-Ordner und eingebaute Titel. Dateiname "Kuenstler - Titel.mp3".
MUSIC_EXTS = {".mp3", ".ogg", ".m4a", ".wav", ".flac"}


def _music_dirs():
    dirs = [DATA_DIR / "music", BASE / "static" / "music",
            bootstrap.bundled_dir() / "static" / "music"]
    try:
        dirs[0].mkdir(exist_ok=True)
    except OSError:
        pass
    return dirs


@app.route("/api/playlist")
def playlist():
    seen, tracks = set(), []
    for d in _music_dirs():
        if not d.exists():
            continue
        for p in sorted(d.iterdir(), key=lambda x: x.name.lower()):
            if not p.is_file() or p.suffix.lower() not in MUSIC_EXTS or p.name in seen:
                continue
            seen.add(p.name)
            artist, sep, title = p.stem.partition(" - ")
            if not sep:
                artist, title = "", p.stem
            tracks.append({"file": p.name, "title": title.strip(), "artist": artist.strip(),
                           "url": "/music/" + quote(p.name)})
    return jsonify(tracks=tracks)


@app.route("/music/<path:fname>")
def music_serve(fname):
    name = os.path.basename(fname)
    for d in _music_dirs():
        target = d / name
        if target.is_file() and target.suffix.lower() in MUSIC_EXTS:
            return send_file(str(target), conditional=True)
    abort(404)


