# Strategien gegen YouTube-Bot-Schutz, der Reihe nach durchprobiert.
# Je Eintrag: (player_clients, cookies-aus-Browser).
# Erst alternative Player-Clients (umgehen den Bot-Check meist OHNE Login),
# danach als letzter Ausweg Browser-Cookies.
STRATEGIES = [
    (None, None),               # Normalfall
    (["tv"], None),             # alternative Clients umgehen den "not a bot"-Check oft
    (["ios"], None),
    (["web_safari"], None),
    (["mweb"], None),
    (None, ("firefox",)),       # ab hier: echte Login-Cookies aus dem Browser
    (None, ("chrome",)),
    (None, ("edge",)),
    (None, ("brave",)),
]
BOT_HINTS = ("sign in to confirm", "not a bot", "confirm you", "use --cookies")
# Fehler, die NICHT nach Bot-Schutz klingen, aber genauso von einem anderen
# Player-Client geheilt werden: YouTube liefert dann Format-URLs, die beim
# eigentlichen Datenabruf 403 werfen, gar keine Formate mehr anbietet, oder
# verlangt einen PO-Token.
RETRY_HINTS = BOT_HINTS + (
    "403", "forbidden", "requested format is not available",
    "only images are available", "po token", "needs to be reloaded",
    "unable to download video data", "fragment", "precondition check failed",
)


def _is_bot_error(msg):
    m = msg.lower()
    return any(h in m for h in BOT_HINTS)


def _is_retryable(msg):
    m = msg.lower()
    return any(h in m for h in RETRY_HINTS)


def _download_youtube(url, fmt, bitrate, start, end, player_clients, cookies):
    """Ein Download-Versuch mit optionalem Player-Client / Cookie-Quelle. Gibt Dateinamen zurueck."""
    uid = uuid.uuid4().hex[:8]
    # Staging in UPLOADS (uid zum Wiederfinden), fertige Datei wandert sauber
    # benannt nach OUTPUT/YouTube.
    opts = {
        "outtmpl": str(UPLOADS / f"{uid}_%(title).80s.%(ext)s"),
        "windowsfilenames": True,
        "noplaylist": True,
        "quiet": True,
        "no_warnings": True,
    }
    if FFMPEG_DIR:
        opts["ffmpeg_location"] = FFMPEG_DIR
    if player_clients:
        opts["extractor_args"] = {"youtube": {"player_client": player_clients}}
    if COOKIES_FILE.exists():
        opts["cookiefile"] = str(COOKIES_FILE)
    if cookies:
        opts["cookiesfrombrowser"] = cookies

    # Dauer nur ermitteln, wenn ein offenes Ende (Start ohne Ende) gebraucht wird.
    if start is not None and end is None:
        with YoutubeDL({**opts, "skip_download": True}) as probe:
            info = probe.extract_info(url, download=False)
        end = info.get("duration") or 0

    if start is not None or end is not None:
        s = start if start is not None else 0.0
        e = end if end is not None else s
        if e <= s:
            raise ValueError("Endzeit muss groesser als Startzeit sein.")
        opts["download_ranges"] = download_range_func(None, [(s, e)])
        opts["force_keyframes_at_cuts"] = True

    if fmt in {"mp3", "wav"}:
        opts["format"] = "bestaudio/best"
        pp = {"key": "FFmpegExtractAudio", "preferredcodec": fmt}
        if fmt == "mp3":
            pp["preferredquality"] = bitrate
        opts["postprocessors"] = [pp]
    else:  # mp4
        opts["format"] = "bv*+ba/b"
        opts["merge_output_format"] = "mp4"

    with YoutubeDL(opts) as ydl:
        ydl.download([url])

    matches = sorted(glob.glob(str(UPLOADS / f"{uid}_*")), key=os.path.getmtime)
    if not matches:
        raise RuntimeError("Keine Ausgabedatei erzeugt.")
    src = Path(matches[-1])
    dst = unique_path(OUT_YT, src.name[9:] or "video")   # "{uid}_" abschneiden
    src.rename(dst)
    return dst


@app.route("/api/youtube", methods=["POST"])
def youtube():
    data = request.get_json(force=True)
    url = (data.get("url") or "").strip()
    fmt = (data.get("format") or "mp3").lower()
    bitrate = str(data.get("bitrate") or "192").strip() or "192"
    start = parse_time(data.get("start"))
    end = parse_time(data.get("end"))

    if not url:
        return jsonify(error="Kein YouTube-Link angegeben."), 400
    if fmt not in {"mp3", "wav", "mp4"}:
        return jsonify(error=f"Unbekanntes Format: {fmt}"), 400
    if start is not None and end is not None and end <= start:
        return jsonify(error="Endzeit muss groesser als Startzeit sein."), 400

    last_err = "Unbekannter Fehler."
    for i, (player_clients, cookies) in enumerate(STRATEGIES):
        try:
            f = _download_youtube(url, fmt, bitrate, start, end, player_clients, cookies)
            return jsonify(file=f.name, download=dl_url(f))
        except Exception as e:
            msg = str(e)
            # Erster (normaler) Versuch UND kein heilbarer Fehler -> echtes
            # Problem (privates Video, Tippfehler im Link ...), sofort melden.
            if i == 0 and not _is_retryable(msg):
                return jsonify(error=f"Download fehlgeschlagen: {msg}"), 400
            last_err = msg  # naechste Strategie probieren

    return jsonify(error=(
        "YouTube blockt gerade als Bot-Schutz und auch alternative Player-Clients/Cookies "
        "haben nicht geholfen. Das ist meist ein temporaeres IP-Limit (kurz warten oder VPN). "
        "Sicherer Notausgang: bei YouTube im Browser einloggen, Cookies als 'cookies.txt' "
        "neben die .exe legen. Tipp: Unten auf 'Updates' tippen - ein neuer YouTube-Downloader "
        "behebt Bot-Blocks oft sofort. "
        f"Details: {last_err}"
    )), 400


@app.route("/api/convert", methods=["POST"])
def convert():
    if "file" not in request.files:
        return jsonify(error="Keine Datei hochgeladen."), 400
    f = request.files["file"]
    target = (request.form.get("target") or "").lower().lstrip(".")
    bitrate = (request.form.get("bitrate") or "").strip()
    if not f or not f.filename:
        return jsonify(error="Keine Datei ausgewaehlt."), 400
    if not target:
        return jsonify(error="Kein Zielformat gewaehlt."), 400

    src_ext = os.path.splitext(f.filename)[1].lower().lstrip(".")
    uid = uuid.uuid4().hex[:8]
    src_path = UPLOADS / f"{uid}_{safe_stem(f.filename)}.{src_ext or 'bin'}"
    f.save(src_path)

    out_path = unique_path(OUT_CONV, f"{safe_stem(f.filename)}.{target}")

    try:
        if src_ext in SVG_EXTS and target in IMAGE_EXTS | {"pdf"}:
            ok, err = convert_svg(src_path, out_path, target)
        elif src_ext in SVG_EXTS:
            ok, err = False, "SVG kann nur in ein Bildformat (PNG, JPG, WEBP …) oder PDF umgewandelt werden."
        elif src_ext in IMAGE_EXTS and target in IMAGE_EXTS | {"pdf"}:
            ok, err = convert_image(src_path, out_path, target)
        else:
            args = ["-i", str(src_path)]
            if target in AUDIO_EXTS:          # Video/Audio -> reines Audio
                args += ["-vn"]
                if bitrate and target in {"mp3", "aac", "ogg", "m4a", "opus"}:
                    args += ["-b:a", f"{bitrate}k"]
            args += [str(out_path)]
            ok, err = ffmpeg_run(args)
        if not ok:
            return jsonify(error=err), 400
    finally:
        try:
            os.remove(src_path)
        except OSError:
            pass

    return jsonify(file=out_path.name, download=dl_url(out_path))


SVG_MIN_EDGE = 2048  # kleine SVGs (Icons) mindestens so gross rendern


def convert_svg(src, dst, target):
    """SVG per resvg rastern (Transparenz bleibt erhalten), dann wie ein Bild speichern."""
    try:
        import resvg_py
    except ImportError:
        return False, "SVG-Unterstuetzung fehlt (pip install resvg-py)."
    try:
        png = resvg_py.svg_to_bytes(svg_path=str(src))
        w, h = Image.open(BytesIO(png)).size
        if max(w, h) < SVG_MIN_EDGE:
            png = resvg_py.svg_to_bytes(svg_path=str(src), zoom=SVG_MIN_EDGE / max(w, h))
        im = Image.open(BytesIO(png))
        im.load()
    except Exception as e:
        return False, f"SVG konnte nicht gelesen werden: {e}"
    return convert_image(im, dst, target)


def convert_image(src, dst, target):
    try:
        im = src if isinstance(src, Image.Image) else Image.open(src)
        # JPEG/BMP/PDF koennen keine Transparenz -> auf weissen Grund legen
        # (sonst werden transparente Flaechen schwarz).
        if target in {"jpg", "jpeg", "bmp", "pdf"} and im.mode in {"RGBA", "LA", "P"}:
            im = im.convert("RGBA")
            flat = Image.new("RGB", im.size, (255, 255, 255))
            flat.paste(im, mask=im.getchannel("A"))
            im = flat
        if target == "pdf":
            im.save(dst, "PDF", resolution=100.0)
            return True, ""
        save_fmt = {"jpg": "JPEG", "jpeg": "JPEG"}.get(target, target.upper())
        kwargs = {}
        if target == "webp":
            kwargs = {"quality": 90, "method": 6}
        elif target in {"jpg", "jpeg"}:
            kwargs = {"quality": 92}
        im.save(dst, save_fmt, **kwargs)
        return True, ""
    except Exception as e:
        return False, f"Bild-Konvertierung fehlgeschlagen: {e}"


# ---------------------------------------------------------------- Komprimieren
# Stufen: Ersparnis vs. Qualitaet. img_max = max. Kantenlaenge (None=Original).
COMPRESS_LEVELS = {
    "light":  {"img_q": 80, "img_max": None, "audio_kbps": "192", "video_crf": "26"},
    "medium": {"img_q": 62, "img_max": 2560, "audio_kbps": "128", "video_crf": "30"},
    "strong": {"img_q": 45, "img_max": 1600, "audio_kbps": "96",  "video_crf": "34"},
}


def _fit(im, maxdim):
    """Bild proportional auf max. Kantenlaenge verkleinern (nur wenn noetig)."""
    if not maxdim:
        return im
    w, h = im.size
    if max(w, h) <= maxdim:
        return im
    if w >= h:
        nw, nh = maxdim, round(h * maxdim / w)
    else:
        nh, nw = maxdim, round(w * maxdim / h)
    return im.resize((max(1, nw), max(1, nh)), Image.LANCZOS)


def compress_image(src, out_dir, stem, ext, cfg):
    im = Image.open(src)
    im = _fit(im, cfg["img_max"])
    e = ext.lower()
    if e in {"jpg", "jpeg"}:
        if im.mode in {"RGBA", "LA", "P"}:
            im = im.convert("RGB")
        out = unique_path(out_dir, f"{stem}.jpg")
        im.save(out, "JPEG", quality=cfg["img_q"], optimize=True, progressive=True)
    elif e == "webp":
        out = unique_path(out_dir, f"{stem}.webp")
        im.save(out, "WEBP", quality=cfg["img_q"], method=6)
    else:  # png/bmp/tiff -> optimiertes PNG (bei medium/strong Palette reduzieren)
        out = unique_path(out_dir, f"{stem}.png")
        if cfg["img_max"] is not None:
            im = im.convert("RGBA").quantize(colors=256, method=Image.FASTOCTREE)
        elif im.mode == "P":
            im = im.convert("RGBA")
        im.save(out, "PNG", optimize=True)
    return out


def compress_video(src, out_dir, stem, cfg):
    out = unique_path(out_dir, f"{stem}.mp4")
    ok, err = ffmpeg_run([
        "-i", str(src), "-c:v", "libx264", "-crf", cfg["video_crf"], "-preset", "veryfast",
        "-c:a", "aac", "-b:a", "128k", "-movflags", "+faststart", str(out),
    ])
    return (out if ok else None), err


def compress_audio(src, out_dir, stem, cfg):
    out = unique_path(out_dir, f"{stem}.mp3")
    ok, err = ffmpeg_run([
        "-i", str(src), "-vn", "-c:a", "libmp3lame", "-b:a", f"{cfg['audio_kbps']}k", str(out),
    ])
    return (out if ok else None), err


@app.route("/api/compress", methods=["POST"])
def compress():
    """Verkleinert EINE Datei (Bild/Video/Audio). Gibt Groessen zurueck."""
    if "file" not in request.files:
        return jsonify(error="Keine Datei hochgeladen."), 400
    f = request.files["file"]
    level = (request.form.get("level") or "medium").lower()
    cfg = COMPRESS_LEVELS.get(level, COMPRESS_LEVELS["medium"])
    if not f or not f.filename:
        return jsonify(error="Keine Datei ausgewaehlt."), 400

    ext = os.path.splitext(f.filename)[1].lower().lstrip(".")
    uid = uuid.uuid4().hex[:8]
    stem = safe_stem(f.filename)
    src_path = UPLOADS / f"{uid}_{stem}.{ext or 'bin'}"
    f.save(src_path)
    orig = src_path.stat().st_size

    try:
        if ext in IMAGE_EXTS and ext != "gif":
            out, err = compress_image(src_path, OUT_COMP, stem, ext, cfg), ""
        elif ext in VIDEO_EXTS:            # inkl. gif -> mp4 (grosse Ersparnis)
            out, err = compress_video(src_path, OUT_COMP, stem, cfg)
        elif ext in AUDIO_EXTS:
            out, err = compress_audio(src_path, OUT_COMP, stem, cfg)
        else:
            return jsonify(error=f"Typ .{ext} laesst sich nicht verkleinern - nutze 'Als ZIP packen'."), 400
        if not out or not out.exists():
            return jsonify(error=err or "Komprimierung fehlgeschlagen."), 400
    except Exception as e:
        return jsonify(error=f"Komprimierung fehlgeschlagen: {e}"), 400
    finally:
        try:
            os.remove(src_path)
        except OSError:
            pass

    return jsonify(file=out.name, download=dl_url(out),
                   orig_size=orig, new_size=out.stat().st_size)


@app.route("/api/zip", methods=["POST"])
def make_zip():
    """Packt mehrere Dateien in EIN .zip-Archiv."""
    files = request.files.getlist("files")
    files = [f for f in files if f and f.filename]
    if not files:
        return jsonify(error="Keine Dateien hochgeladen."), 400

    out = unique_path(OUT_COMP, "Archiv.zip")
    orig_total, used = 0, set()
    with zipfile.ZipFile(out, "w", zipfile.ZIP_DEFLATED, compresslevel=9) as zf:
        for f in files:
            arc = os.path.basename(f.filename) or "datei"
            base, i = arc, 1
            while arc in used:              # Namensdopplungen vermeiden
                stem, dot, e = base.rpartition(".")
                arc = f"{stem or base}_{i}{('.'+e) if dot else ''}"
                i += 1
            used.add(arc)
            data = f.read()
            orig_total += len(data)
            zf.writestr(arc, data)

    return jsonify(file=out.name, download=dl_url(out),
                   orig_size=orig_total, new_size=out.stat().st_size, count=len(files))


# ---------------------------------------------------------------- Freisteller
# Bild-Hintergrund per KI entfernen (rembg/onnx). Modell (~170 MB) wird beim
# allerersten Aufruf automatisch nach ~/.u2net geladen.
_rembg_session = None
_rembg_lock = threading.Lock()


def _get_rembg():
    global _rembg_session
    with _rembg_lock:
        if _rembg_session is None:
            from rembg import new_session
            _rembg_session = new_session("isnet-general-use")
        return _rembg_session


@app.route("/api/removebg", methods=["POST"])
def removebg():
    if importlib.util.find_spec("rembg") is None:
        return jsonify(error="rembg ist nicht installiert. "
                             "Im Terminal: pip install rembg onnxruntime"), 400
    if "file" not in request.files:
        return jsonify(error="Keine Datei hochgeladen."), 400
    f = request.files["file"]
    bg_mode = (request.form.get("bg") or "transparent").lower()
    if not f or not f.filename:
        return jsonify(error="Keine Datei ausgewaehlt."), 400
    ext = os.path.splitext(f.filename)[1].lower().lstrip(".")
    if ext not in IMAGE_EXTS:
        return jsonify(error=f".{ext} ist kein Bild — bitte PNG/JPG/WebP hochladen."), 400

    uid = uuid.uuid4().hex[:8]
    stem = safe_stem(f.filename)
    src_path = UPLOADS / f"{uid}_{stem}.{ext}"
    f.save(src_path)
    try:
        from rembg import remove
        im = Image.open(src_path).convert("RGBA")
        cut = remove(im, session=_get_rembg())
        if bg_mode == "white":
            base = Image.new("RGBA", cut.size, "#ffffffff")
            base.alpha_composite(cut)
            cut = base.convert("RGB")
        out = unique_path(OUT_BG, f"{stem}_frei.png")
        cut.save(out, "PNG", optimize=True)
    except Exception as e:
        return jsonify(error=f"Freistellen fehlgeschlagen: {e}"), 400
    finally:
        try:
            os.remove(src_path)
