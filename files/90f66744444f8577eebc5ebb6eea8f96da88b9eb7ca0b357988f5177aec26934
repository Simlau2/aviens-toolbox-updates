@app.route("/api/vectorize", methods=["POST"])
def vectorize():
    if importlib.util.find_spec("vtracer") is None:
        return jsonify(error="vtracer ist nicht installiert. "
                             "Im Terminal: pip install vtracer"), 400
    if "file" not in request.files:
        return jsonify(error="Keine Datei hochgeladen."), 400
    f = request.files["file"]
    mode = (request.form.get("mode") or "color").lower()
    cfg = VEC_DETAIL.get((request.form.get("detail") or "normal").lower(), VEC_DETAIL["normal"])
    if not f or not f.filename:
        return jsonify(error="Keine Datei ausgewaehlt."), 400
    ext = os.path.splitext(f.filename)[1].lower().lstrip(".")
    if ext not in IMAGE_EXTS:
        return jsonify(error=f".{ext} ist kein Bild — bitte PNG/JPG/WebP hochladen."), 400

    uid = uuid.uuid4().hex[:8]
    stem = safe_stem(f.filename)
    src_path = UPLOADS / f"{uid}_{stem}.{ext}"
    f.save(src_path)
    tmp_png = UPLOADS / f"{uid}_vt.png"
    try:
        import vtracer
        im = Image.open(src_path)
        # Transparenz auf Weiss legen + auf max. 2000 px begrenzen (Tempo/Groesse).
        if im.mode in {"RGBA", "LA", "P"}:
            im = im.convert("RGBA")
            base = Image.new("RGBA", im.size, "#ffffffff")
            base.alpha_composite(im)
            im = base
        im = _fit(im.convert("RGB"), 2000)
        im.save(tmp_png, "PNG")

        out = unique_path(OUT_VEC, f"{stem}.svg")
        vtracer.convert_image_to_svg_py(
            str(tmp_png), str(out),
            colormode="binary" if mode == "bw" else "color",
            filter_speckle=cfg["filter_speckle"],
            color_precision=cfg["color_precision"],
            layer_difference=cfg["layer_difference"],
        )
        if not out.exists():
            return jsonify(error="Vektorisierung hat keine Datei erzeugt."), 400
    except Exception as e:
        return jsonify(error=f"Vektorisierung fehlgeschlagen: {e}"), 400
    finally:
        for p in (src_path, tmp_png):
            try:
                os.remove(p)
            except OSError:
                pass
    return jsonify(file=out.name, download=dl_url(out))


# ---------------------------------------------------------------- QR-Codes
def _hex_rgb(s, default=(0, 0, 0)):
    s = (s or "").strip().lstrip("#")
    if len(s) == 3:
        s = "".join(c * 2 for c in s)
    if not re.fullmatch(r"[0-9a-fA-F]{6}", s):
        return default
    return tuple(int(s[i:i + 2], 16) for i in (0, 2, 4))


def _qr_matrix(text):
    import qrcode
    q = qrcode.QRCode(error_correction=qrcode.constants.ERROR_CORRECT_M, border=2)
    q.add_data(text)
    q.make(fit=True)
    return q.get_matrix()          # inkl. Ruhezone (border)


def _qr_png(matrix, size, fg, bg, style):
    """Matrix -> PIL-Bild. bg=None -> transparent. style: 'square' | 'round'."""
    n = len(matrix)
    ss = 2 if style == "round" else 1          # Supersampling gegen Treppchen
    px = max(3, round(size / n)) * ss
    s = px * n
    img = Image.new("RGBA", (s, s), (*bg, 255) if bg else (0, 0, 0, 0))
    d = ImageDraw.Draw(img)
    pad = max(1, round(px * 0.09))
    for y, row in enumerate(matrix):
        for x, v in enumerate(row):
            if not v:
                continue
            x0, y0 = x * px, y * px
            if style == "round":
                d.ellipse([x0 + pad, y0 + pad, x0 + px - pad, y0 + px - pad], fill=(*fg, 255))
            else:
                d.rectangle([x0, y0, x0 + px - 1, y0 + px - 1], fill=(*fg, 255))
    if ss > 1:
        img = img.resize((s // ss, s // ss), Image.LANCZOS)
    return img


def _qr_svg(matrix, size, fg, bg, style):
    n = len(matrix)
    fg_hex = "#%02x%02x%02x" % fg
    crisp = ' shape-rendering="crispEdges"' if style != "round" else ""
    parts = [f'<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 {n} {n}" '
             f'width="{size}" height="{size}"{crisp}>']
    if bg:
        parts.append('<rect width="%d" height="%d" fill="#%02x%02x%02x"/>' % (n, n, *bg))
    if style == "round":
        dots = "".join(f'<circle cx="{x + 0.5}" cy="{y + 0.5}" r="0.41"/>'
                       for y, row in enumerate(matrix) for x, v in enumerate(row) if v)
        parts.append(f'<g fill="{fg_hex}">{dots}</g>')
    else:
        path = "".join(f"M{x} {y}h1v1h-1z"
                       for y, row in enumerate(matrix) for x, v in enumerate(row) if v)
        parts.append(f'<path d="{path}" fill="{fg_hex}"/>')
    parts.append("</svg>")
    return "".join(parts)


@app.route("/api/qr", methods=["POST"])
def qr_make():
    if importlib.util.find_spec("qrcode") is None:
        return jsonify(error="qrcode ist nicht installiert. Im Terminal: pip install qrcode"), 400
    data = request.get_json(force=True)
    text = (data.get("text") or "").strip()
    if not text:
        return jsonify(error="Bitte Text oder URL eingeben."), 400
    fg = _hex_rgb(data.get("fg"), (16, 48, 58))
    bg = None if data.get("transparent") else _hex_rgb(data.get("bg"), (255, 255, 255))
    style = "round" if (data.get("style") or "") == "round" else "square"
    fmt = "svg" if (data.get("format") or "") == "svg" else "png"
    try:
        size = min(4096, max(120, int(data.get("size") or 1024)))
    except (TypeError, ValueError):
        size = 1024

    try:
        matrix = _qr_matrix(text)
        if data.get("preview"):            # Live-Vorschau: PNG direkt zurueck, nichts speichern
            buf = BytesIO()
            _qr_png(matrix, 360, fg, bg, style).save(buf, "PNG")
            buf.seek(0)
            return send_file(buf, mimetype="image/png")
        # Kein safe_stem: das wuerde ".de" einer URL als Dateiendung abschneiden.
        raw = re.sub(r"^https?://(www\.)?", "", text)
        stem = re.sub(r"[^\w.\- ]+", "_", raw).strip("._ ")[:40] or "code"
        out = unique_path(OUT_QR, f"QR_{stem}.{fmt}")
        if fmt == "svg":
            out.write_text(_qr_svg(matrix, size, fg, bg, style), encoding="utf-8")
        else:
            _qr_png(matrix, size, fg, bg, style).save(out, "PNG", optimize=True)
    except Exception as e:
        return jsonify(error=f"QR-Code fehlgeschlagen: {e}"), 400
    return jsonify(file=out.name, download=dl_url(out))


# ---------------------------------------------------------------- Transkription
# Video/Stream (m3u8, YouTube, ...) oder lokale Datei -> .txt + .srt via faster-whisper.
# Download- und Whisper-Worker sind getrennt: signierte Stream-URLs (z.B. CloudFront)
# laufen ab, deshalb werden ALLE Downloads sofort gezogen, waehrend die Transkription
# nacheinander laeuft (GPU/Modell kann eh nur seriell).
TRANSCRIBE_MODELS = {"large-v3", "medium", "small"}

_jobs = {}                      # job_id -> dict (interner Zustand)
_jobs_lock = threading.Lock()
_dl_queue = queue.Queue()       # Jobs, die noch heruntergeladen werden muessen
_tx_queue = queue.Queue()       # Jobs, die bereit fuer Whisper sind
_workers_started = False
_whisper_cache = {}             # model_name -> (WhisperModel, "GPU"|"CPU")
_whisper_lock = threading.Lock()


def _job_update(jid, **kw):
    with _jobs_lock:
        _jobs[jid].update(kw)


def _job_get(jid, key, default=None):
    with _jobs_lock:
        return _jobs[jid].get(key, default)


def _hms(s):
    s = int(s)
    return f"{s // 3600:02d}:{s % 3600 // 60:02d}:{s % 60:02d}"


def _srt_ts(s):
    ms = int(round(s * 1000))
    return f"{ms // 3600000:02d}:{ms % 3600000 // 60000:02d}:{ms % 60000 // 1000:02d},{ms % 1000:03d}"


def _nvidia_dll_dirs():
    """bin-Ordner mit den CUDA-DLLs (cublas/cudnn).

    Dev: pip-Pakete nvidia-cublas-cu12/nvidia-cudnn-cu12 in site-packages.
    .exe: von PyInstaller nach _MEIPASS/nvidia/<paket>/bin gebuendelt."""
    dirs = glob.glob(os.path.join(resource_path("nvidia"), "*", "bin"))
    try:
        import nvidia
        for base in nvidia.__path__:
            dirs += glob.glob(os.path.join(base, "*", "bin"))
    except ImportError:
        pass
    return dirs


def _pick_device():
    """'cuda' nur, wenn cuBLAS/cuDNN wirklich ladbar sind — sonst crasht ctranslate2 hart.

    ctranslate2 laedt die CUDA-DLLs per einfachem LoadLibrary (PATH-Suche, ignoriert
    os.add_dll_directory). Deshalb: bin-Ordner der nvidia-pip-Pakete in den PATH haengen
    UND die DLLs vorab in den Prozess laden."""
    loaded = []
    if sys.platform == "win32":
        for d in _nvidia_dll_dirs():
            os.environ["PATH"] = d + os.pathsep + os.environ.get("PATH", "")
            try:
                os.add_dll_directory(d)
            except OSError:
                pass
            for dll in glob.glob(os.path.join(d, "*.dll")):
                try:
                    ctypes.WinDLL(dll)
                    loaded.append(os.path.basename(dll).lower())
                except OSError:
                    pass
    try:
        import ctranslate2
        if ctranslate2.get_cuda_device_count() > 0:
            if sys.platform == "win32" and not (
                    any(n.startswith("cublas64") for n in loaded)
                    and any(n.startswith("cudnn_ops64") for n in loaded)):
                # System-Installation von CUDA/cuDNN als letzte Chance
                ctypes.WinDLL("cublas64_12.dll")
                ctypes.WinDLL("cudnn_ops64_9.dll")
            return "cuda", "float16"
    except Exception:
        pass
    return "cpu", "int8"


def _get_whisper(name):
    with _whisper_lock:
        if name in _whisper_cache:
            return _whisper_cache[name]
        from faster_whisper import WhisperModel
        device, compute = _pick_device()
        try:
            model = WhisperModel(name, device=device, compute_type=compute)
        except Exception:
            device = "cpu"
            model = WhisperModel(name, device="cpu", compute_type="int8")
        entry = (model, "GPU" if device == "cuda" else "CPU")
        _whisper_cache[name] = entry
        return entry


def _transcribe_download(jid, url, referer, keep_video):
    """Laedt die Quelle (m3u8/YouTube/...) nach OUTPUT und gibt den Pfad zurueck."""
    uid = uuid.uuid4().hex[:8]

    def hook(d):
        if d.get("status") != "downloading":
            return
        tot = d.get("total_bytes") or d.get("total_bytes_estimate") or 0
        got = d.get("downloaded_bytes") or 0
        frags, frag_i = d.get("fragment_count"), d.get("fragment_index")
        if tot:
            pct = got * 100 / tot
        elif frags:
            pct = (frag_i or 0) * 100 / frags
        else:
            pct = 0
        _job_update(jid, progress=round(min(99, pct)))

    opts = {
        "outtmpl": str(UPLOADS / f"{uid}_%(title).80s.%(ext)s"),
        "windowsfilenames": True,
        "noplaylist": True,
        "quiet": True,
        "no_warnings": True,
        "progress_hooks": [hook],
        "concurrent_fragment_downloads": 4,
    }
    if FFMPEG_DIR:
        opts["ffmpeg_location"] = FFMPEG_DIR
    if COOKIES_FILE.exists():
        opts["cookiefile"] = str(COOKIES_FILE)
    if referer:
        u = urlparse(referer)
        origin = f"{u.scheme}://{u.netloc}" if u.scheme and u.netloc else referer
        opts["http_headers"] = {"Referer": referer, "Origin": origin}
    if keep_video:
        opts["format"] = "bv*+ba/b"
        opts["merge_output_format"] = "mp4"
        opts["postprocessors"] = [{"key": "FFmpegVideoRemuxer", "preferedformat": "mp4"}]
    else:
        opts["format"] = "bestaudio/best"

    # Wie beim YouTube-Downloader: bei heilbaren Fehlern (403, fehlende Formate,
    # Bot-Check) die alternativen Player-Clients der Reihe nach durchprobieren.
    last_exc = None
    for i, (player_clients, cookies) in enumerate(STRATEGIES):
        o = dict(opts)
        if player_clients:
            o["extractor_args"] = {"youtube": {"player_client": player_clients}}
        if cookies:
            o["cookiesfrombrowser"] = cookies
        try:
            with YoutubeDL(o) as ydl:
                ydl.download([url])
            last_exc = None
            break
        except Exception as e:
            last_exc = e
            if i == 0 and not _is_retryable(str(e)):
                raise
    if last_exc is not None:
        raise last_exc

    matches = sorted(glob.glob(str(UPLOADS / f"{uid}_*")), key=os.path.getmtime)
    if not matches:
        raise RuntimeError("Download hat keine Datei erzeugt.")
    src = Path(matches[-1])
    dst = unique_path(OUT_TR, src.name[9:] or "video")   # "{uid}_" abschneiden
    src.rename(dst)
    return dst


def _extract_wav(src):
    """Audiospur als 16-kHz-Mono-WAV nach UPLOADS (Whisper-Input, wird geloescht)."""
    wav = UPLOADS / f"{src.stem}_16k.wav"
    ok, err = ffmpeg_run(["-i", str(src), "-vn", "-ac", "1", "-ar", "16000", str(wav)])
    if not ok or not wav.exists():
        raise RuntimeError(f"Audio-Extraktion fehlgeschlagen: {err}")
    return wav


def _run_whisper(jid, wav, model_name, language, out_stem):
    _job_update(jid, phase="modell", progress=0)
    model, device = _get_whisper(model_name)
    _job_update(jid, device=device)

    # Dauer direkt aus der WAV-Groesse (16 kHz mono 16-bit = 32000 Byte/s).
    duration = max(0.001, (wav.stat().st_size - 44) / 32000)
    segments, _info = model.transcribe(
        str(wav),
        language=None if language == "auto" else language,
        vad_filter=True,      # Stille/Pausen ueberspringen — spart bei Webinaren viel Zeit
        beam_size=5,
    )

    txt_lines, srt_blocks, n = [], [], 0
    for seg in segments:
        text = seg.text.strip()
        if not text:
            continue
        n += 1
        txt_lines.append(f"[{_hms(seg.start)}] {text}")
        srt_blocks.append(f"{n}\n{_srt_ts(seg.start)} --> {_srt_ts(seg.end)}\n{text}\n")
        _job_update(jid, phase="transkription", progress=round(min(99, seg.end * 100 / duration)))

    txt_path = unique_path(OUT_TR, f"{out_stem}.txt")
    srt_path = unique_path(OUT_TR, f"{out_stem}.srt")
    txt_path.write_text("\n".join(txt_lines), encoding="utf-8")
    srt_path.write_text("\n".join(srt_blocks), encoding="utf-8")
    return txt_path, srt_path


def _dl_worker():
    while True:
        jid = _dl_queue.get()
        try:
            _job_update(jid, phase="download", progress=0)
            src = _transcribe_download(
                jid, _job_get(jid, "url"), _job_get(jid, "referer"), _job_get(jid, "keep_video"))
            _job_update(jid, src_path=str(src), label=src.name, phase="warten", progress=0)
            _tx_queue.put(jid)
        except Exception as e:
            msg = str(e)
            if "Unsupported URL" in msg:
                msg += ("  Hinweis: Das ist eine Webseiten-URL, kein Video-Stream. Bei Login-Portalen "
                        "(WebinarJam & Co.): Video im Browser abspielen, F12 → Netzwerk-Tab → "
                        "nach 'm3u8' filtern → diese URL hier einfuegen.")
            _job_update(jid, phase="fehler", error=f"Download fehlgeschlagen: {msg}")


def _tx_worker():
    while True:
        jid = _tx_queue.get()
        wav = None
        try:
            src = Path(_job_get(jid, "src_path"))
            _job_update(jid, phase="audio", progress=0)
            wav = _extract_wav(src)
            out_stem = _job_get(jid, "out_stem") or src.stem
            txt, srt = _run_whisper(
                jid, wav, _job_get(jid, "model"), _job_get(jid, "language"), out_stem)

            files = []
            if _job_get(jid, "url"):    # Quelle kam per Download -> mit anbieten
                kind = "MP4" if _job_get(jid, "keep_video") else "Audio"
                files.append({"kind": kind, "download": dl_url(src)})
            files.append({"kind": "TXT", "download": dl_url(txt)})
            files.append({"kind": "SRT", "download": dl_url(srt)})
            _job_update(jid, phase="fertig", progress=100, files=files)
        except Exception as e:
            _job_update(jid, phase="fehler", error=str(e))
        finally:
            for p in (wav, (Path(_job_get(jid, "src_path")) if _job_get(jid, "cleanup_src") else None)):
                try:
                    if p:
                        os.remove(p)
                except OSError:
                    pass


def _ensure_workers():
    global _workers_started
    if _workers_started:
        return
    _workers_started = True
    threading.Thread(target=_dl_worker, daemon=True).start()
    threading.Thread(target=_tx_worker, daemon=True).start()


@app.route("/api/transcribe", methods=["POST"])
def transcribe_start():
    if importlib.util.find_spec("faster_whisper") is None:
        return jsonify(error="faster-whisper ist nicht installiert. "
                             "Im Terminal: pip install faster-whisper"), 400

    model = (request.form.get("model") or "large-v3").strip()
    language = (request.form.get("language") or "de").strip()
    referer = (request.form.get("referer") or "").strip()
    keep_video = (request.form.get("keep_video") or "1") == "1"
    urls = [u.strip() for u in (request.form.get("urls") or "").split("\n") if u.strip()]
    files = [f for f in request.files.getlist("files") if f and f.filename]

    if model not in TRANSCRIBE_MODELS:
        return jsonify(error=f"Unbekanntes Modell: {model}"), 400
    if not urls and not files:
        return jsonify(error="Bitte Links eingeben oder Dateien auswaehlen."), 400

    _ensure_workers()
    jobs_out = []

    def new_job(label, **extra):
        jid = uuid.uuid4().hex[:12]
        with _jobs_lock:
            _jobs[jid] = {"label": label, "phase": "wartet", "progress": 0,
                          "model": model, "language": language, "referer": referer,
                          "keep_video": keep_video, "files": [], **extra}
        jobs_out.append({"id": jid, "label": label})
        return jid

    for url in urls:
        short = url if len(url) <= 60 else url[:60] + "…"
        _dl_queue.put(new_job(short, url=url))

    for f in files:
        ext = os.path.splitext(f.filename)[1].lower().lstrip(".") or "bin"
        uid = uuid.uuid4().hex[:8]
        src = UPLOADS / f"{uid}_{safe_stem(f.filename)}.{ext}"
        f.save(src)
        _tx_queue.put(new_job(os.path.basename(f.filename),
                              src_path=str(src), cleanup_src=True, url=None,
                              out_stem=safe_stem(f.filename)))

    return jsonify(jobs=jobs_out)


@app.route("/api/transcribe/status")
def transcribe_status():
    ids = [i for i in (request.args.get("ids") or "").split(",") if i]
