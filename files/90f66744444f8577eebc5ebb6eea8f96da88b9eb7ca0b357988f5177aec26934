    custom = _custom_path()
    models = [{"key": k, "name": m["name"], "tag": m["tag"], "vram": m["vram"], "hint": m["hint"],
               "ref": m["ref"], "installed": not _gen_missing(k),
               "bytes": sum(GEN_PARTS[p]["size"] for p in _gen_missing(k))}
              for k, m in GEN_MODELS.items()]
    return jsonify(ready=not missing and (model != "custom" or custom is not None),
                   setup=setup, models=models, custom=str(custom) if custom else "",
                   missing=[{"key": k, "label": GEN_PARTS[k]["label"], "size": GEN_PARTS[k]["size"]}
                            for k in missing],
                   missing_bytes=sum(GEN_PARTS[k]["size"] for k in missing))


