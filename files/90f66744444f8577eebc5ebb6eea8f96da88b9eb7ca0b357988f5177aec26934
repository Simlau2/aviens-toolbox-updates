# ---------------------------------------------------------------- helpers
def parse_time(s):
    """'14' | '1:30' | '1:02:03' | '14.5'  ->  Sekunden (float) oder None."""
    if s is None:
        return None
    s = str(s).strip()
    if not s:
        return None
    try:
        parts = [float(p) for p in s.split(":")]
    except ValueError:
        return None
    sec = 0.0
    for p in parts:
        sec = sec * 60 + p
    return sec


def safe_stem(name):
    name = os.path.splitext(os.path.basename(name))[0]
    name = re.sub(r"[^\w.\- ]+", "_", name).strip()
    return name or "datei"


def unique_path(directory, name):
    """Freier Pfad im Ordner — bei Namenskollision ' (2)', ' (3)' ... anhaengen."""
    stem, dot, ext = name.rpartition(".")
    cand = directory / name
    i = 2
    while cand.exists():
        cand = directory / (f"{stem} ({i}).{ext}" if dot else f"{name} ({i})")
        i += 1
    return cand


def dl_url(path):
    """/download-URL fuer eine Datei unterhalb von OUTPUT (inkl. Unterordner)."""
    return "/download/" + path.relative_to(OUTPUT).as_posix()


def ffmpeg_run(args):
    """Fuehrt ffmpeg aus und gibt (ok, stderr) zurueck."""
    try:
        proc = subprocess.run(
            [FFMPEG, "-y", *args],
            capture_output=True, text=True, encoding="utf-8", errors="replace",
            creationflags=getattr(subprocess, "CREATE_NO_WINDOW", 0),
        )
    except FileNotFoundError:
        return False, "ffmpeg wurde nicht gefunden (nicht im PATH)."
    if proc.returncode != 0:
        tail = "\n".join(proc.stderr.strip().splitlines()[-6:])
        return False, tail or "ffmpeg-Fehler"
    return True, ""


