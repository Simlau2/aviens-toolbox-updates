@app.route("/api/gen/custom", methods=["POST"])
def gen_custom():
    """Merkt sich den Pfad zu einer eigenen Modell-Datei (leer = vergessen)."""
    raw = str((request.get_json(silent=True) or {}).get("path") or "").strip().strip('"')
    if not raw:
        CUSTOM_CFG.unlink(missing_ok=True)
        return jsonify(ok=True, path="")
    p = Path(raw)
    if not p.is_file():
        return jsonify(error="Datei nicht gefunden."), 400
    if p.suffix.lower() not in CUSTOM_EXTS:
        return jsonify(error="Bitte eine .safetensors-, .gguf- oder .ckpt-Datei angeben."), 400
    CUSTOM_CFG.write_text(json.dumps({"path": str(p)}), encoding="utf-8")
    return jsonify(ok=True, path=str(p))


_GEN_STEP_RE = re.compile(r"(\d+)\s*/\s*(\d+)\s*-\s*[\d.]+\s*(?:s/it|it/s)")


def _gen_run(jid):
    job = _gen_jobs[jid]
    exe = _sd_exe()
    w, h = GEN_SIZES.get(job["ratio"], GEN_SIZES["1:1"])
    stem = re.sub(r"[^\w\- ]+", "", job["prompt"])[:40].strip() or "bild"
    outs = []
    for n in range(job["count"]):
        seed = job["seed"] + n if job["seed"] >= 0 else random.randint(0, 2**31 - 1)
        out = unique_path(OUT_GEN, f"{stem}_{seed}.png")
        if job["model"] == "custom":
            # Kompletter Checkpoint (SD 1.5 / SDXL ...): Engine erkennt die Bauart selbst.
            weights = ["-m", job["custom"]]
            if job.get("negative"):
                weights += ["-n", job["negative"]]
        else:
            parts = GEN_MODELS[job["model"]]["parts"]
            weights = ["--diffusion-model", str(GEN_PARTS[parts["diffusion"]]["path"]),
                       "--vae", str(GEN_PARTS[parts["vae"]]["path"]),
                       "--llm", str(GEN_PARTS[parts["llm"]]["path"])]
        args = [str(exe), *weights,
                "-p", job["prompt"], "--cfg-scale", str(job["cfg"]), "--steps", str(job["steps"]),
                "-W", str(w), "-H", str(h), "-s", str(seed), "-o", str(out),
                "--diffusion-fa", "--offload-to-cpu"]
        if job.get("ref"):
            args += ["-r", job["ref"]]
        proc = subprocess.Popen(
            args, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, cwd=str(exe.parent),
            creationflags=getattr(subprocess, "CREATE_NO_WINDOW", 0))
        job["proc"] = proc
        tail, buf = [], b""
        while True:
            chunk = proc.stdout.read(256)
            if not chunk:
                break
            buf += chunk
            *lines, buf = re.split(rb"[\r\n]", buf)
            for raw in lines:
                line = raw.decode("utf-8", "replace").strip()
                if not line:
                    continue
                m = _GEN_STEP_RE.search(line)
                if m and int(m.group(2)) == job["steps"]:
                    # Sampling ist nur ein Teil der Zeit: danach folgt das Dekodieren (VAE).
                    step, steps = int(m.group(1)), int(m.group(2))
                    frac = (n + 0.6 * step / steps) / job["count"]
                    job.update(phase="dekodieren" if step == steps else "bild",
                               progress=min(99, round(frac * 100)))
                elif not m:
                    tail = (tail + [line])[-8:]
        proc.wait()
        if job.get("cancel"):
            raise RuntimeError("Abgebrochen.")
        if proc.returncode != 0 or not out.exists():
            raise RuntimeError("Generierung fehlgeschlagen: " + " | ".join(tail[-3:]))
        outs.append({"file": out.name, "download": dl_url(out),
                     "view": "/view/" + out.relative_to(OUTPUT).as_posix(), "seed": seed})
        job["files"] = list(outs)


def _gen_worker():
    while True:
        jid = _gen_queue.get()
        job = _gen_jobs[jid]
        try:
            if job.get("cancel"):
                raise RuntimeError("Abgebrochen.")
            job.update(phase="modell", progress=0)
            _gen_run(jid)
            job.update(phase="fertig", progress=100)
        except Exception as e:
            job.update(phase="fehler", error=str(e))
        finally:
            job.pop("proc", None)
            if job.get("ref"):
                try:
                    os.remove(job["ref"])
                except OSError:
                    pass


@app.route("/api/gen", methods=["POST"])
def gen_start():
    global _gen_worker_started
    prompt = (request.form.get("prompt") or "").strip()
    model = _gen_model_key(request.form.get("model"))
    custom = _custom_path()
    if not prompt:
        return jsonify(error="Bitte beschreibe, was du sehen willst."), 400
    if model == "custom" and custom is None:
        return jsonify(error="Bitte zuerst eine eigene Modell-Datei angeben."), 400
    if _gen_missing(model):
        return jsonify(error="Das Modell ist noch nicht eingerichtet."), 400
    preset = GEN_MODELS.get(model, {"steps": 24, "cfg": 6.0, "ref": False})
    try:
        seed = int(request.form.get("seed") or -1)
        count = min(4, max(1, int(request.form.get("count") or 1)))
        steps, cfg = preset["steps"], preset["cfg"]
        if model == "custom":                  # nur hier sind Schritte/CFG frei waehlbar
            steps = min(60, max(1, int(request.form.get("steps") or steps)))
            cfg = min(20.0, max(1.0, float(request.form.get("cfg") or cfg)))
    except ValueError:
        return jsonify(error="Seed, Anzahl, Schritte und CFG muessen Zahlen sein."), 400

    ref = None
    f = request.files.get("ref") if preset["ref"] else None
    if f and f.filename:
        ext = os.path.splitext(f.filename)[1].lower().lstrip(".")
        if ext not in IMAGE_EXTS:
            return jsonify(error=f".{ext} ist kein Bild."), 400
        ref_path = UPLOADS / f"{uuid.uuid4().hex[:8]}_ref.png"
        _fit(Image.open(f.stream).convert("RGB"), 1536).save(ref_path, "PNG")
        ref = str(ref_path)

    jid = uuid.uuid4().hex[:12]
    _gen_jobs[jid] = {"prompt": prompt, "model": model, "custom": str(custom or ""),
                      "negative": (request.form.get("negative") or "").strip(),
                      "seed": seed, "count": count, "steps": steps, "cfg": cfg, "ratio": request.form.get("ratio") or "1:1", "ref": ref,
                      "phase": "wartet", "progress": 0, "files": [], "error": ""}
    if not _gen_worker_started:
        _gen_worker_started = True
        threading.Thread(target=_gen_worker, daemon=True).start()
    _gen_queue.put(jid)
    return jsonify(id=jid)


@app.route("/api/gen/job/<jid>")
def gen_job(jid):
    job = _gen_jobs.get(jid)
    if not job:
        abort(404)
    return jsonify({k: job.get(k) for k in ("phase", "progress", "files", "error")})


@app.route("/api/gen/cancel/<jid>", methods=["POST"])
def gen_cancel(jid):
    job = _gen_jobs.get(jid)
    if not job:
        abort(404)
    job["cancel"] = True
    proc = job.get("proc")
    if proc and proc.poll() is None:
        proc.kill()
    return jsonify(ok=True)


# ---------------------------------------------------------------- Auto-Updater
# Auf dem Webspace liegt ein Ordner mit
#   manifest.json   {"version", "min_runtime", "notes", "installer_url", "files": {pfad: {sha256, size}}}
#   files/<sha256>  die Dateien selbst, nach Inhalt benannt
# (erzeugt von publish_update.py). Geladen wird nur, was sich geaendert hat. Das
# Update landet in <Datenordner>/update/v<Version>/ und wird beim naechsten Start
# von bootstrap.py benutzt. Braucht eine Version neue Python-Pakete
# (min_runtime > eingebaute Runtime), wird stattdessen der Installer angeboten.
_upd_lock = threading.Lock()
_upd_state = {"phase": "idle", "progress": 0, "error": "", "version": ""}
_upd_manifest = None
_sha_cache = {}


def update_url():
    """Basis-URL des Update-Kanals ('' = Updater aus)."""
    if os.environ.get("AVIENS_UPDATE_URL"):
        return os.environ["AVIENS_UPDATE_URL"].rstrip("/") + "/"
    for f in (DATA_DIR / "update_channel.json", Path(resource_path("update_channel.json"))):
        try:
            url = str(json.loads(f.read_text(encoding="utf-8")).get("url") or "").strip()
        except (OSError, ValueError):
            continue
        if url:
            return url.rstrip("/") + "/"
    return ""


def _sha256(path):
    key = (str(path), path.stat().st_mtime_ns, path.stat().st_size)
    if key not in _sha_cache:
        h = hashlib.sha256()
        with open(path, "rb") as fh:
            for chunk in iter(lambda: fh.read(1 << 20), b""):
                h.update(chunk)
        _sha_cache[key] = h.hexdigest()
    return _sha_cache[key]


def _safe_rel(rel):
    p = Path(rel)
    return not (p.is_absolute() or ".." in p.parts or ":" in rel or rel.startswith(("/", "\\")))


def _fetch_manifest():
    base = update_url()
    if not base:
        raise RuntimeError("Kein Update-Kanal eingerichtet.")
    if not base.startswith("https://") and not base.startswith("http://127.0.0.1"):
        raise RuntimeError("Der Update-Kanal muss https sein.")
    with _http_open(base + "manifest.json?t=" + str(int(time.time())), timeout=12) as resp:
        man = json.loads(resp.read().decode("utf-8"))
    if not isinstance(man.get("files"), dict) or not man.get("version"):
        raise RuntimeError("manifest.json ist unvollstaendig.")
    return man


def _upd_info(man):
    newer = bootstrap.parse_version(man["version"]) > bootstrap.parse_version(APP_VERSION)
    needs_installer = int(man.get("min_runtime") or 0) > bootstrap.RUNTIME
    return {"current": APP_VERSION, "latest": str(man["version"]), "available": newer,
            "ytdlp": YTDLP_VERSION, "latest_ytdlp": str(man.get("ytdlp") or ""),
            "notes": str(man.get("notes") or ""), "needs_installer": newer and needs_installer,
            "installer_url": str(man.get("installer_url") or "")}


@app.route("/api/update/check")
def update_check():
    global _upd_manifest
    if not update_url():
        return jsonify(current=APP_VERSION, ytdlp=YTDLP_VERSION, available=False, configured=False)
    try:
        _upd_manifest = _fetch_manifest()
    except Exception as e:
        return jsonify(current=APP_VERSION, ytdlp=YTDLP_VERSION, available=False,
                       configured=True, error=str(e))
    return jsonify(configured=True, **_upd_info(_upd_manifest))


def _upd_run(man):
    try:
        base = update_url()
        version = re.sub(r"[^\w.\-]", "_", str(man["version"]))
        root = bootstrap.update_root()
        target = root / f"v{version}"
        shutil.rmtree(target, ignore_errors=True)
        target.mkdir(parents=True)
        bundled = bootstrap.bundled_dir()

        jobs, total = [], 0
        for rel, meta in man["files"].items():
            if not _safe_rel(rel) or not re.fullmatch(r"[0-9a-f]{64}", str(meta.get("sha256"))):
                raise RuntimeError(f"Ungueltiger Eintrag im Manifest: {rel}")
            local = None
            for src_root in (BASE, bundled):
                cand = src_root / rel
                if cand.is_file() and _sha256(cand) == meta["sha256"]:
                    local = cand
                    break
            # Unveraenderte eingebaute static-Dateien muessen nicht kopiert werden:
            # /static faellt automatisch auf die eingebaute Fassung zurueck.
            if local and rel.startswith("static/") and local == bundled / rel:
                continue
            jobs.append((rel, meta, local))
            if not local:
                total += int(meta.get("size") or 0)

        got = 0
        for rel, meta, local in jobs:
            dest = target / rel
            dest.parent.mkdir(parents=True, exist_ok=True)
            if local:
                shutil.copy2(local, dest)
                continue

            def prog(have, _t, base_got=got):
                with _upd_lock:
                    _upd_state["progress"] = min(99, round((base_got + have) * 100 / max(1, total)))

            _download(base + "files/" + meta["sha256"], dest, prog)
            if _sha256(dest) != meta["sha256"]:
                raise RuntimeError(f"Pruefsumme stimmt nicht: {rel}")
            got += int(meta.get("size") or 0)

        if not (target / "app.py").exists() or not (target / "version.json").exists():
            raise RuntimeError("Update enthaelt kein app.py / version.json.")
        tmp = root / "current.json.tmp"
        tmp.write_text(json.dumps({"dir": target.name, "version": man["version"]}), encoding="utf-8")
        tmp.replace(root / "current.json")
        with _upd_lock:
            _upd_state.update(phase="ready", progress=100, version=str(man["version"]))
    except Exception as e:
        with _upd_lock:
            _upd_state.update(phase="error", error=f"Update fehlgeschlagen: {e}")


@app.route("/api/update/apply", methods=["POST"])
def update_apply():
    man = _upd_manifest
    if not man or not _upd_info(man)["available"]:
        return jsonify(error="Kein Update verfuegbar."), 400
    if _upd_info(man)["needs_installer"]:
        return jsonify(error="Diese Version braucht den neuen Installer."), 400
    with _upd_lock:
        if _upd_state["phase"] != "running":
            _upd_state.update(phase="running", progress=0, error="")
            threading.Thread(target=_upd_run, args=(man,), daemon=True).start()
    return jsonify(ok=True)


@app.route("/api/update/status")
def update_status():
    with _upd_lock:
        return jsonify(**_upd_state)


@app.route("/api/update/restart", methods=["POST"])
def update_restart():
    """Startet das Programm neu, damit die neue Version geladen wird."""
    frozen = getattr(sys, "frozen", False)
    if not frozen and "desktop" not in os.path.basename(sys.argv[0]).lower():
        return jsonify(ok=False, error="Im Entwicklermodus bitte von Hand neu starten."), 400
    cmd = [sys.executable] if frozen else [sys.executable, *sys.argv]

    def later():
        time.sleep(0.6)
        subprocess.Popen(cmd, close_fds=True)
        os._exit(0)

    threading.Thread(target=later, daemon=True).start()
    return jsonify(ok=True)


@app.route("/api/open-url", methods=["POST"])
def open_url():
    """Oeffnet einen https-Link (Installer-Download) im Standardbrowser."""
    url = str((request.get_json(silent=True) or {}).get("url") or "")
    if not url.startswith("https://"):
        return jsonify(ok=False), 400
    webbrowser.open(url)
    return jsonify(ok=True)


@app.route("/view/<path:fname>")
def view(fname):
    """Wie /download, aber zur Anzeige im Fenster (Bild-Vorschau)."""
    target = (OUTPUT / fname).resolve()
    if OUTPUT.resolve() not in target.parents or not target.is_file():
        abort(404)
    return send_file(target, conditional=True)


@app.route("/bg.mp4")
def bg_video():
    """Hintergrund-Video (Loop). 'bg.mp4' neben der .exe ueberschreibt das gebuendelte."""
    user = DATA_DIR / "bg.mp4"
    f = user if user.exists() else Path(resource_path("static/bg.mp4"))
    if not f.exists():
        abort(404)
    return send_file(str(f))


@app.route("/download/<path:fname>")
def download(fname):
    target = (OUTPUT / fname).resolve()
    if OUTPUT.resolve() not in target.parents or not target.exists():
        abort(404)
    nice = re.sub(r"^[0-9a-f]{8}_", "", target.name)  # uid-Praefix alter Dateien entfernen
    return send_file(target, as_attachment=True, download_name=nice)


