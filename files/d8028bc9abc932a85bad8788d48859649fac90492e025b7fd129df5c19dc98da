<body>
<!-- ===================== Start-Animation ===================== -->
<div id="intro" aria-hidden="true">
  <div class="rays"></div>
  <div class="flare"></div>
  <div class="wave"></div>
  <div class="orbwrap">
    <i class="ring"></i><i class="ring"></i><i class="ring"></i><i class="ring"></i>
    <img class="orb" src="/static/img/appicon-512.png" alt="">
  </div>
  <h1 id="intro-title">Aviens Toolbox</h1>
  <p>Medien · Design · KI</p>
