</div>
<script>
(function(){
  var root=document.documentElement, intro=document.getElementById('intro');
  if(!root.classList.contains('intro-on')){ intro.remove(); return; }
  try{ sessionStorage.setItem('av_intro','1'); }catch(e){}
  // Name in einzelne Buchstaben zerlegen (gestaffelter Auftritt)
  var h=document.getElementById('intro-title'), txt=h.textContent; h.textContent='';
  txt.split('').forEach(function(ch,i){
    var sp=document.createElement('span'); sp.style.setProperty('--i',i);
    sp.textContent = ch===' ' ? '\u00a0' : ch; h.appendChild(sp);
  });
  // Seifenblasen
  for(var i=0;i<14;i++){
    var b=document.createElement('i'); b.className='bub';
    b.style.setProperty('--x',(Math.random()*100-4)+'%');
    b.style.setProperty('--s',(34+Math.random()*110)+'px');
    b.style.setProperty('--d',(2.2+Math.random()*1.8)+'s');
    b.style.setProperty('--w',(Math.random()*1.5)+'s');
    b.style.setProperty('--sway',(Math.random()*120-60)+'px');
    intro.insertBefore(b, intro.querySelector('.orbwrap'));
  }
  // leiser Start-Klang (nur wenn der Browser Ton ohne Klick erlaubt)
  try{
    var AC=window.AudioContext||window.webkitAudioContext, ac=new AC();
    if(ac.state==='running'){
      [[523.25,.45],[659.25,.6],[783.99,.75],[1046.5,1.0]].forEach(function(n){
        var o=ac.createOscillator(), g=ac.createGain(), t=ac.currentTime+n[1];
        o.type='sine'; o.frequency.value=n[0];
        g.gain.setValueAtTime(0.0001,t); g.gain.exponentialRampToValueAtTime(0.12,t+0.03);
        g.gain.exponentialRampToValueAtTime(0.0001,t+1.4);
        o.connect(g).connect(ac.destination); o.start(t); o.stop(t+1.5);
      });
    }
  }catch(e){}
  var done=false;
  function finish(){
    if(done) return; done=true;
    root.classList.add('intro-end');          // Seite darf jetzt ihre Auftritte spielen
    intro.classList.add('out');
    setTimeout(function(){ intro.remove(); root.classList.remove('intro-on','intro-end'); }, 800);
  }
  if(location.search.indexOf('intro=hold')<0) setTimeout(finish, 2900);
  intro.addEventListener('pointerdown', finish);
  window.addEventListener('keydown', finish, {once:true});
})();
</script>
