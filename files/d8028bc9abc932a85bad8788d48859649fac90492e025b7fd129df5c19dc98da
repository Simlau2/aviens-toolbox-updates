/* ===================== Komprimieren ===================== */
let compMode='shrink', compLevel='medium', cchosen=[];

wirePills('#comp-mode', v=>{
  compMode=v;
  $('#shrink-opts').classList.toggle('hidden', compMode!=='shrink');
  $('#zip-opts').classList.toggle('hidden', compMode!=='zip');
  $('#comp-go').querySelector('span').textContent = compMode==='zip' ? 'ZIP erstellen' : 'Komprimieren';
});
wirePills('#comp-level', v=>compLevel=v);
wireDrop('#cdrop','#cfile-input',list=>{
  cchosen=list;
  $('#cdrop-text').textContent=dropLabel(list);
  $('#comp-go').disabled=!list.length;
});

function compDone(row, d){
  const saved = d.orig_size>0 ? Math.round((1 - d.new_size/d.orig_size)*100) : 0;
  const savTxt = saved>0 ? `−${saved} %` : '±0 %';
  const nice = d.file.replace(/^[0-9a-f]{8}_/,'');
  row.className='res ok';
  row.innerHTML=`${icon('check')}
    <div class="name">${nice}<small>${fmtSize(d.orig_size)} → ${fmtSize(d.new_size)} · ${savTxt}</small></div>
    ${fileAction(d.download)}`;
}
$('#comp-go').onclick = async ()=>{
  if(!cchosen.length) return;
  const res=$('#comp-res'), cnt=$('#comp-count');
  res.innerHTML=''; cnt.classList.remove('hidden'); $('#comp-go').disabled=true;
  if(compMode==='zip'){
    const row=addRow(res, `${cchosen.length} Datei(en) → ZIP`);
    cnt.textContent='Packe ZIP …';
    const fd=new FormData(); for(const f of cchosen) fd.append('files', f);
    try{
      const r=await fetch('/api/zip',{method:'POST',body:fd}); const d=await r.json();
      if(r.ok) compDone(row,d); else setRow(row,false,(d.error||'Fehler'));
    }catch(e){ setRow(row,false,e.message); }
    cnt.textContent='Fertig.';
  } else {
    let done=0;
    for(const file of cchosen){
      const row=addRow(res, file.name);
      cnt.textContent=`Komprimiere ${done+1} / ${cchosen.length} …`;
      const fd=new FormData(); fd.append('file',file); fd.append('level',compLevel);
      try{
        const r=await fetch('/api/compress',{method:'POST',body:fd}); const d=await r.json();
        if(r.ok) compDone(row,d); else setRow(row,false,(d.error||'Fehler')+' — '+file.name);
      }catch(e){ setRow(row,false,e.message+' — '+file.name); }
      done++;
    }
    cnt.textContent=`Fertig: ${cchosen.length} Datei(en)`;
  }
  $('#comp-go').disabled=false;
  loadStats();
};

/* ===================== Transkript ===================== */
let tchosen=[], trKeep='1';
wireDrop('#tdrop','#tfile-input',list=>{
  tchosen=list;
  $('#tdrop-text').textContent=dropLabel(list);
});
wirePills('#tr-keep', v=>trKeep=v);

const TR_PHASE={wartet:'wartet', download:'Download läuft', warten:'wartet auf Transkription',
  audio:'Audio wird extrahiert', modell:'Whisper-Modell wird geladen', transkription:'Transkription'};

$('#tr-go').onclick = async ()=>{
  const urls=$('#tr-url').value.split('\n').map(s=>s.trim()).filter(Boolean);
  const res=$('#tr-res'), cnt=$('#tr-count');
  cnt.classList.remove('hidden');
  if(!urls.length && !tchosen.length){ cnt.textContent='Bitte Links eingeben oder Dateien wählen.'; return; }
  $('#tr-go').disabled=true; res.innerHTML=''; cnt.textContent='Starte …';

  const fd=new FormData();
  fd.append('urls', urls.join('\n'));
  fd.append('model', $('#tr-model').value);
  fd.append('language', $('#tr-lang').value);
  fd.append('referer', $('#tr-referer').value.trim());
  fd.append('keep_video', trKeep);
  for(const f of tchosen) fd.append('files', f);

  let jobs;
  try{
    const r=await fetch('/api/transcribe',{method:'POST',body:fd});
    const d=await r.json();
    if(!r.ok){ cnt.textContent=d.error||'Fehler'; $('#tr-go').disabled=false; return; }
    jobs=d.jobs;
  }catch(e){ cnt.textContent=e.message; $('#tr-go').disabled=false; return; }

  const rows={};
  for(const j of jobs) rows[j.id]=addRow(res, j.label);
  const ids=jobs.map(j=>j.id).join(',');

  while(true){
    await new Promise(r=>setTimeout(r,1500));
    let d;
    try{ const r=await fetch('/api/transcribe/status?ids='+ids); d=await r.json(); }
    catch(e){ continue; }
    let open=0, done=0;
    for(const j of jobs){
      const st=d.jobs[j.id], row=rows[j.id];
      if(!st || !row) continue;
      if(st.phase==='fertig'){
        done++;
        if(!row.dataset.done){
          row.dataset.done='1'; row.className='res ok';
          const links=(st.files||[]).map(f=>fileAction(f.download, f.kind)).join('');
          row.innerHTML=`${icon('check')}<div class="name">${st.label}</div>${links}`;
        }
      } else if(st.phase==='fehler'){
        if(!row.dataset.done){ row.dataset.done='1'; setRow(row,false,(st.error||'Fehler')+' — '+st.label); }
      } else {
        open++;
        const pct=st.progress?` · ${st.progress} %`:'';
        const dev=st.device?` · ${st.device}`:'';
        row.querySelector('.name').textContent=`${st.label} — ${TR_PHASE[st.phase]||st.phase}${pct}${dev}`;
      }
    }
    cnt.textContent = open ? `Läuft … ${done} / ${jobs.length} fertig` : `Fertig: ${done} / ${jobs.length}`;
    if(!open) break;
  }
  $('#tr-go').disabled=false;
  loadStats();
};

