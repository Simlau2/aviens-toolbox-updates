  /* Update-Dialog */
  #upd-box{position:fixed;inset:0;z-index:85;display:flex;align-items:center;justify-content:center;
    background:rgba(0,25,50,.45);-webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px)}
