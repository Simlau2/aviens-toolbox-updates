/* ===================== Popup-Gadget ===================== */
(()=>{
  const LS = window.localStorage;
  const layer = $('#popup-layer');
  const btnPopups = $('#btn-popups');
  let popupsOn = LS.getItem('av_popups') !== 'off';

  // kurzer Ton beim Wegklicken eines Popups
  let actx=null;
  function audioCtx(){
    if(!actx){ try{ actx=new (window.AudioContext||window.webkitAudioContext)(); }catch(e){} }
    if(actx&&actx.state==='suspended') actx.resume();
    return actx;
  }
  function popSound(){
    const ac=audioCtx(); if(!ac) return;
    const t=ac.currentTime;
    const o=ac.createOscillator(), g=ac.createGain();
    o.type='sine'; o.frequency.setValueAtTime(420,t); o.frequency.exponentialRampToValueAtTime(1300,t+0.12);
    g.gain.setValueAtTime(0.0001,t); g.gain.exponentialRampToValueAtTime(0.4,t+0.015);
    g.gain.exponentialRampToValueAtTime(0.0001,t+0.22);
    o.connect(g).connect(ac.destination); o.start(t); o.stop(t+0.24);
  }

  let imgs=[];
  const live=[];
  const MAX_LIVE=5;
  let popupTimer=null, rafId=null;

  fetch('/api/popups').then(r=>r.json()).then(d=>{ imgs=d.images||[]; }).catch(()=>{});

  function spawnPopup(){
    if(!popupsOn || !imgs.length || live.length>=MAX_LIVE) return;
    const url = imgs[Math.floor(Math.random()*imgs.length)];
    const el = document.createElement('div');
    el.className='popup';
    const im = new Image();
    im.onload=()=>{
      if(!popupsOn){ el.remove(); return; }
      const ar = im.naturalWidth/im.naturalHeight || 1.6;
      const w = 150 + Math.random()*90;
      const h = w/ar;
      const x = Math.random()*Math.max(10,(innerWidth - w));
      const y = Math.random()*Math.max(10,(innerHeight - h));
      const sp = 0.6 + Math.random()*0.9;
      const ang = Math.random()*Math.PI*2;
      const p = {el, x, y, vx:Math.cos(ang)*sp*60, vy:Math.sin(ang)*sp*60, w, h};
      el.style.width=w+'px'; el.style.height=h+'px';
      el.style.transform=`translate(${x}px,${y}px)`;
      el.onclick=()=>dismiss(p);
      live.push(p);
    };
    im.src=url; el.appendChild(im); layer.appendChild(el);
  }

  function dismiss(p){
    popSound();
    p.el.classList.add('bye');
    const i=live.indexOf(p); if(i>=0) live.splice(i,1);
    setTimeout(()=>p.el.remove(), 260);
  }

  let lastT=performance.now();
  function tick(now){
    const dt=Math.min(0.05,(now-lastT)/1000); lastT=now;
    for(const p of live){
      p.x+=p.vx*dt; p.y+=p.vy*dt;
      if(p.x<=0){p.x=0;p.vx=Math.abs(p.vx);} else if(p.x+p.w>=innerWidth){p.x=innerWidth-p.w;p.vx=-Math.abs(p.vx);}
      if(p.y<=0){p.y=0;p.vy=Math.abs(p.vy);} else if(p.y+p.h>=innerHeight){p.y=innerHeight-p.h;p.vy=-Math.abs(p.vy);}
      p.el.style.transform=`translate(${p.x}px,${p.y}px)`;
    }
    rafId=requestAnimationFrame(tick);
  }

  function scheduleNext(){
    clearTimeout(popupTimer);
    const wait = 8000 + Math.random()*18000;
    popupTimer=setTimeout(()=>{ spawnPopup(); scheduleNext(); }, wait);
  }

  function startPopups(){
    if(!rafId){ lastT=performance.now(); rafId=requestAnimationFrame(tick); }
    scheduleNext(); setTimeout(spawnPopup, 2500);
  }
  function stopPopups(){
    clearTimeout(popupTimer);
    while(live.length) dismissNoSound(live[0]);
    layer.innerHTML='';
  }
  function dismissNoSound(p){ const i=live.indexOf(p); if(i>=0) live.splice(i,1); p.el.remove(); }

  function syncPopupBtn(){
    btnPopups.classList.toggle('off', !popupsOn);
    btnPopups.title = popupsOn ? 'Popup-Gadget: an' : 'Popup-Gadget: aus';
  }
  btnPopups.onclick = ()=>{
    popupsOn=!popupsOn; LS.setItem('av_popups', popupsOn?'on':'off'); syncPopupBtn();
    if(popupsOn) startPopups(); else stopPopups();
  };
  syncPopupBtn();
  if(popupsOn) startPopups();
})();

/* ===================== Player + Playlist ===================== */
(()=>{
  const LS = window.localStorage;
  const bgm = $('#bgm'), seek = $('#pl-seek'), vol = $('#pl-vol');
  let tracks = [], order = [], pos = 0;
  let wantPlay = LS.getItem('av_music') === 'on';
  let shuffle = LS.getItem('av_shuffle') !== 'off';
  let lastVol = 30;

  const fmtT = s => isFinite(s) ? Math.floor(s/60)+':'+String(Math.floor(s%60)).padStart(2,'0') : '0:00';
  const fill = el => el.style.setProperty('--v', ((el.value-el.min)*100/(el.max-el.min))+'%');

  function makeOrder(keepId){
    order = tracks.map((_,i)=>i);
    if(shuffle){
      for(let i=order.length-1;i>0;i--){ const j=Math.floor(Math.random()*(i+1)); [order[i],order[j]]=[order[j],order[i]]; }
    }
    pos = Math.max(0, order.indexOf(keepId));
    if(shuffle && keepId!=null){ [order[0],order[pos]]=[order[pos],order[0]]; pos=0; }
  }
  function load(p, autoplay){
    if(!tracks.length) return;
    pos = (p+order.length)%order.length;
    const t = tracks[order[pos]];
    bgm.src = t.url;
    const meta = $('#player .meta'); meta.classList.add('swap');
    setTimeout(()=>{ $('#pl-title').textContent = t.title;
      $('#pl-artist').textContent = t.artist || 'Aviens Toolbox'; meta.classList.remove('swap'); }, 220);
    LS.setItem('av_track', t.file);
    renderList();
    if(autoplay) bgm.play().catch(()=>{});
  }
  function syncPlay(){
    $('#pl-play-ic').style.setProperty('--ic', `url(${ICO(bgm.paused?'play':'pause')})`);
    $('#player').classList.toggle('playing', !bgm.paused);
    $('#plist').classList.toggle('paused', bgm.paused);
  }
  function renderList(){
    const box = $('#plist');
    if(!tracks.length){
      box.innerHTML = `<div class="hd">Playlist</div><div class="ft">Noch keine Titel. Lege MP3-Dateien in den Ordner
        <b>music</b> neben dem Programm — Dateiname: Künstler - Titel.mp3</div>`;
      return;
    }
    box.innerHTML = `<div class="hd">Playlist · ${tracks.length} Titel</div>`;
    tracks.forEach((t,i)=>{
      const row = document.createElement('div');
      row.className = 'tr'+(i===order[pos]?' now':'');
      row.innerHTML = `<span class="n">${i===order[pos]?'<span class="eq"><i></i><i></i><i></i></span>':i+1}</span><span class="t">${t.title}<small>${t.artist||''}</small></span>`;
      row.onclick = ()=>{ wantPlay=true; LS.setItem('av_music','on'); load(order.indexOf(i), true); };
      box.appendChild(row);
    });
    const ft = document.createElement('div'); ft.className='ft';
    ft.textContent = 'Eigene Musik: MP3s in den Ordner "music" neben dem Programm legen.';
    box.appendChild(ft);
  }

  $('#pl-play').onclick = ()=>{
    if(!tracks.length){ toast('Keine Musik gefunden.'); return; }
    if(bgm.paused){ wantPlay=true; bgm.play().catch(()=>{}); } else { wantPlay=false; bgm.pause(); }
    LS.setItem('av_music', wantPlay?'on':'off');
  };
  $('#pl-next').onclick = ()=>load(pos+1, !bgm.paused || wantPlay);
  $('#pl-prev').onclick = ()=>{
    if(bgm.currentTime>3){ bgm.currentTime=0; return; }
    load(pos-1, !bgm.paused || wantPlay);
  };
  $('#pl-shuffle').onclick = ()=>{
    shuffle=!shuffle; LS.setItem('av_shuffle', shuffle?'on':'off');
    $('#pl-shuffle').classList.toggle('on', shuffle);
    makeOrder(order[pos]); renderList();
  };
  $('#pl-list').onclick = e=>{ e.stopPropagation(); $('#plist').classList.toggle('hidden'); };
  document.addEventListener('click', e=>{
    if(!e.target.closest('#plist')) $('#plist').classList.add('hidden');
  });

  bgm.addEventListener('play', syncPlay);
  bgm.addEventListener('pause', syncPlay);
  bgm.addEventListener('ended', ()=>load(pos+1, true));
  bgm.addEventListener('error', ()=>{ if(tracks.length>1) load(pos+1, wantPlay); });
  bgm.addEventListener('timeupdate', ()=>{
    if(seek.dataset.drag) return;
    seek.value = bgm.duration ? Math.round(bgm.currentTime*1000/bgm.duration) : 0; fill(seek);
    $('#pl-cur').textContent = fmtT(bgm.currentTime);
    $('#pl-dur').textContent = fmtT(bgm.duration);
  });
  seek.addEventListener('input', ()=>{ seek.dataset.drag='1'; fill(seek); });
  seek.addEventListener('change', ()=>{
    if(bgm.duration) bgm.currentTime = seek.value/1000*bgm.duration;
    delete seek.dataset.drag;
  });

  function setVol(v){
    vol.value=v; fill(vol); bgm.volume=v/100; LS.setItem('av_vol', v);
    $('#pl-mute-ic').style.setProperty('--ic', `url(${ICO(v>0?'sound':'mute')})`);
  }
  vol.addEventListener('input', ()=>setVol(+vol.value));
  $('#pl-mute').onclick = ()=>{
    if(+vol.value>0){ lastVol=+vol.value; setVol(0); } else setVol(lastVol||30);
  };
  setVol(+(LS.getItem('av_vol') ?? 30));
  $('#pl-shuffle').classList.toggle('on', shuffle);
  fill(seek);

  // Browser erlauben Ton erst nach der ersten Eingabe
  let unlocked=false;
  function unlock(){ if(unlocked) return; unlocked=true; if(wantPlay && bgm.paused) bgm.play().catch(()=>{}); }
  window.addEventListener('pointerdown', unlock);
  window.addEventListener('keydown', unlock);

  fetch('/api/playlist').then(r=>r.json()).then(d=>{
    tracks = d.tracks||[];
    const last = tracks.findIndex(t=>t.file===LS.getItem('av_track'));
    makeOrder(shuffle || last<0 ? null : last);
    if(shuffle && tracks.length) pos = Math.floor(Math.random()*order.length);
    load(pos, wantPlay);
    renderList();
  }).catch(()=>renderList());
})();

/* ===================== Auto-Updater ===================== */
(()=>{
  let info=null, timer=null;
  const box=$('#upd-box'), bar=$('#upd-bar'), go=$('#upd-go');

  function openBox(){
    if(!info) return;
    $('#upd-title').textContent = `Version ${info.latest} ist da`;
    $('#upd-sub').textContent = info.needs_installer
      ? `Du hast ${info.current}. Diese Version braucht einmalig den neuen Installer.`
      : `Du hast ${info.current}. Das Update lädt nur die geänderten Dateien.`;
    const yt = info.latest_ytdlp && info.latest_ytdlp!==info.ytdlp
      ? `Neuer YouTube-Downloader: ${info.latest_ytdlp} (bisher ${info.ytdlp}).` : '';
    const notes = [info.notes, yt].filter(Boolean).join('\n');
    $('#upd-notes').textContent = notes;
    $('#upd-notes').classList.toggle('hidden', !notes);
    go.textContent = info.needs_installer ? 'Installer laden' : 'Jetzt aktualisieren';
    go.disabled = false; go.dataset.mode = info.needs_installer ? 'installer' : 'apply';
    bar.classList.add('hidden');
    box.classList.remove('hidden');
  }
  async function check(manual){
    let d;
    try{ d = await (await fetch('/api/update/check')).json(); }
    catch(e){ if(manual) toast('Update-Prüfung fehlgeschlagen.'); return; }
    if(d.available){
      info=d; $('#upd-btn').classList.remove('hidden');
      if(manual || localStorage.getItem('av_upd_seen')!==d.latest){
        localStorage.setItem('av_upd_seen', d.latest); openBox();
      }
    } else if(manual){
      toast(d.configured===false ? 'Kein Update-Kanal eingerichtet.'
          : d.error ? 'Update-Server nicht erreichbar.' : `Alles aktuell (v${d.current}).`);
    }
  }
  async function poll(){
    let st;
    try{ st = await (await fetch('/api/update/status')).json(); }catch(e){ return; }
    bar.firstElementChild.style.width = st.progress+'%';
    if(st.phase==='ready'){
      clearInterval(timer);
      $('#upd-sub').textContent = 'Fertig geladen. Nach dem Neustart läuft die neue Version.';
      go.textContent='Neu starten'; go.disabled=false; go.dataset.mode='restart';
    } else if(st.phase==='error'){
      clearInterval(timer);
      $('#upd-sub').textContent = st.error; go.textContent='Nochmal versuchen'; go.disabled=false; go.dataset.mode='apply';
    }
  }
  go.onclick = async ()=>{
    const mode = go.dataset.mode;
    if(mode==='installer'){
      await fetch('/api/open-url',{method:'POST',headers:{'Content-Type':'application/json'},
        body:JSON.stringify({url:info.installer_url})});
      box.classList.add('hidden');
    } else if(mode==='restart'){
      const r = await fetch('/api/update/restart',{method:'POST'});
      if(r.ok){ $('#upd-sub').textContent='Starte neu …'; setTimeout(()=>location.reload(), 4000); }
      else { const d=await r.json(); $('#upd-sub').textContent=d.error||'Bitte von Hand neu starten.'; }
    } else {
      go.disabled=true; bar.classList.remove('hidden'); bar.firstElementChild.style.width='0%';
      $('#upd-sub').textContent='Lade Update …';
      const r = await fetch('/api/update/apply',{method:'POST'});
      if(!r.ok){ const d=await r.json(); $('#upd-sub').textContent=d.error||'Fehler'; go.disabled=false; return; }
      clearInterval(timer); timer=setInterval(poll, 700);
    }
  };
  $('#upd-later').onclick = ()=>box.classList.add('hidden');
  $('#upd-btn').onclick = openBox;
  $('#btn-update').onclick = ()=>check(true);
  setTimeout(()=>check(false), 1500);
  setInterval(()=>check(false), 6*3600*1000);
})();

