  .plist{
    position:fixed;right:max(12px,calc(50vw - 390px));bottom:88px;z-index:71;width:300px;max-height:min(360px,55vh);
    overflow:auto;border-radius:16px;padding:6px;box-shadow:var(--shadow);
  }
  .plist .hd{padding:8px 10px 6px;font-size:11px;font-weight:600;color:var(--ink-2)}
