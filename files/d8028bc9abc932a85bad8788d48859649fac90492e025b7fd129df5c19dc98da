  #upd-box .btns{display:flex;gap:8px;justify-content:flex-end;margin-top:16px}


  /* =====================================================================
     Mikroanimationen — kurz, weich, nie im Weg. Bei "Bewegung reduzieren"
     (Systemeinstellung) sind sie aus.
     ===================================================================== */
  @keyframes fade-in{from{opacity:0}to{opacity:1}}
