    100%{clip-path:circle(0% at 50% 42%);filter:brightness(1.6)}
  }
  /* solange das Intro laeuft, warten die Auftritts-Animationen der Seite */
  html.intro-on:not(.intro-end) .wrap *,html.intro-on:not(.intro-end) .wrap,
  html.intro-on:not(.intro-end) .player{animation-play-state:paused !important}

  #intro .flare{position:absolute;left:50%;top:42%;width:min(130vmin,900px);aspect-ratio:1;
    margin:calc(min(130vmin,900px)/-2) 0 0 calc(min(130vmin,900px)/-2);opacity:0;
    background:url(/static/img/fx-flare.webp) center/contain no-repeat;
    animation:intro-flare 2.6s ease-out .1s forwards}
  @keyframes intro-flare{0%{opacity:0;transform:scale(.2) rotate(-40deg)}35%{opacity:1}
    100%{opacity:.85;transform:scale(1.15) rotate(25deg)}}

  #intro .rays{position:absolute;inset:-20%;opacity:.35;mix-blend-mode:screen;
    background:repeating-conic-gradient(from 0deg at 50% 45%,rgba(255,255,255,.55) 0 6deg,transparent 6deg 20deg);
    -webkit-mask-image:radial-gradient(circle at 50% 45%,#000 0,transparent 62%);mask-image:radial-gradient(circle at 50% 45%,#000 0,transparent 62%);
    animation:spin 40s linear infinite}

  #intro .bub{position:absolute;bottom:-160px;left:var(--x);width:var(--s);aspect-ratio:1;opacity:.9;
    background:url(/static/img/fx-bubble.webp) center/contain no-repeat;
