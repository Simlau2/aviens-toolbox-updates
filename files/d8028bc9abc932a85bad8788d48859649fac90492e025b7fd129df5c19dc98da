<script>
const $ = s => document.querySelector(s);

/* Symbol-Helfer: erzeugt eine eingefaerbte PNG-Maske aus static/img. */
const ICO = n => `/static/img/ic-${n}.png`;
const icon = (n, extra='') => `<i class="ic" style="--ic:url(${ICO(n)})${extra}"></i>`;

/* ===================== Werkzeuge ===================== */
const TOOLS = [
  {id:'gen',  ic:'tanga',      name:'Tanga Generator', desc:'KI-Bilder lokal: FLUX.2, Z-Image & mehr'},
  {id:'yt',   ic:'youtube',    name:'YouTube',       desc:'Video & Audio laden, auch Ausschnitte'},
  {id:'file', ic:'convert',    name:'Konvertieren',  desc:'Bild · SVG · Audio · Video · PDF'},
  {id:'comp', ic:'compress',   name:'Komprimieren',  desc:'Verkleinern oder als ZIP packen'},
  {id:'tr',   ic:'transcript', name:'Transkript',    desc:'Whisper: Sprache → Text + SRT'},
  {id:'bg',   ic:'cutout',     name:'Freisteller',   desc:'Hintergrund per KI entfernen'},
  {id:'vec',  ic:'vector',     name:'Vektorisierer', desc:'PNG/JPG → skalierbares SVG'},
  {id:'qr',   ic:'qr',         name:'QR-Codes',      desc:'Mit Farbe & Stil, PNG oder SVG'},
  {id:'col',  ic:'colors',     name:'Farben',        desc:'HEX/RGB/HSL/OKLCH & Kontrast'},
];
const TOOL = Object.fromEntries(TOOLS.map(t=>[t.id,t]));
const TOOLIMG = n => `/static/img/tool-${n}.png`;

(function buildTiles(){
  const box = $('#tiles');
  for(const t of TOOLS){
    const el = document.createElement('div');
    el.className = 'tile';
    el.style.setProperty('--i', box.children.length);
    el.innerHTML = `<img src="${TOOLIMG(t.ic)}" alt="">
      <div class="tx"><div class="nm">${t.name}</div><div class="ds">${t.desc}</div></div>`;
    el.onclick = ()=>show(t.id);
    box.appendChild(el);
  }
})();

/* ===================== Navigation ===================== */
function show(id){
  const t = TOOL[id];
  if(!t) id='home';
  $('#home').classList.toggle('hidden', id!=='home');
  $('#toolbar').classList.toggle('hidden', id==='home');
  for(const x of TOOLS) $('#tab-'+x.id).classList.add('hidden');
  if(t){
    $('#tab-'+id).classList.remove('hidden');
    $('#tt-ico').src = TOOLIMG(t.ic);
    $('#tt-name').textContent = t.name;
  } else {
    loadRecent();
  }
  if(id==='gen' && window.genReady) genRefresh();
  const want = id==='home' ? '' : '#'+id;
  if(location.hash!==want) history.replaceState(null,'',want||location.pathname);
  scrollTo({top:0});
}
$('#backbtn').onclick = ()=>show('home');
window.addEventListener('hashchange',()=>show(location.hash.slice(1)||'home'));
window.addEventListener('keydown',e=>{
  if(e.key==='Escape' && !(e.target.closest && e.target.closest('input,textarea,select'))) show('home');
});
show(location.hash.slice(1)||'home');

/* ===================== Ausgabe-Ordner + Meldungen ===================== */
let toastTimer=null;
function toast(msg){
  const el=$('#toast'); el.textContent=msg; el.classList.add('show');
  clearTimeout(toastTimer); toastTimer=setTimeout(()=>el.classList.remove('show'),2200);
}
async function openFolder(sub){
  try{
    const r = await fetch('/api/open-folder',{method:'POST',
      headers:{'Content-Type':'application/json'}, body:JSON.stringify({sub:sub||''})});
    if(!r.ok) toast('Ordner nicht gefunden.');
  }catch(e){ toast('Ordner konnte nicht geöffnet werden.'); }
}
$('#open-folder').onclick = ()=>openFolder();

/* ===================== Zuletzt erstellte Dateien ===================== */
const CAT_ICON = {YouTube:'youtube',Konvertiert:'convert',Komprimiert:'compress',
  Transkripte:'transcript',Freigestellt:'cutout',Vektoren:'vector','QR-Codes':'qr','Tanga Generator':'tanga'};

function fmtSize(b){
  if(b>=1073741824) return (b/1073741824).toFixed(1)+' GB';
  if(b>=1048576) return (b/1048576).toFixed(1)+' MB';
  if(b>=1024) return (b/1024).toFixed(0)+' KB';
  return b+' B';
}
function fmtAgo(sec){
  if(sec<90) return 'gerade eben';
  if(sec<5400) return 'vor '+Math.round(sec/60)+' Min.';
  if(sec<172800) return 'vor '+Math.round(sec/3600)+' Std.';
  return 'vor '+Math.round(sec/86400)+' Tagen';
}

async function loadRecent(){
  let d;
  try{ const r=await fetch('/api/stats'); d=await r.json(); }catch(e){ return; }
  $('#st-size').textContent = d.total ? `${d.total} Dateien · ${fmtSize(d.bytes)}` : '';
  const rec = $('#st-recent');
  if(!d.recent.length){
    rec.innerHTML = '<div class="empty">Noch nichts erstellt.</div>';
    return;
  }
  rec.innerHTML = '';
  for(const f of d.recent){
    const row=document.createElement('div'); row.className='fl';
    row.style.setProperty('--i', rec.children.length);
    row.innerHTML = `<img src="${TOOLIMG(CAT_ICON[f.dir]||'folder')}" alt=""><span class="nm">${f.name}</span>
      <span class="mt">${fmtAgo(f.age)}</span>`;
    row.title = f.dir+' · '+fmtSize(f.size)+' — im Ordner zeigen';
    row.onclick = ()=>revealFile(f.dir+'/'+f.file);
    rec.appendChild(row);
  }
}
async function revealFile(rel){
  try{
    const r = await fetch('/api/reveal',{method:'POST',headers:{'Content-Type':'application/json'},
      body:JSON.stringify({file:rel})});
    if(!r.ok) toast('Datei nicht gefunden.');
  }catch(e){}
}
loadRecent();

const loadStats = loadRecent;

/* ===================== gemeinsame Bausteine ===================== */
function wirePills(sel, cb){
  const root=$(sel);
  root.querySelectorAll('.pill').forEach(p=>p.onclick=()=>{
    root.querySelectorAll('.pill').forEach(x=>x.classList.remove('active'));
    p.classList.add('active'); cb(p.dataset.v);
  });
}
function wireDrop(dropSel, inputSel, apply){
  const drop=$(dropSel), input=$(inputSel);
  drop.onclick=()=>input.click();
  input.onchange=()=>apply([...input.files]);
  ['dragover','dragenter'].forEach(ev=>drop.addEventListener(ev,e=>{e.preventDefault();drop.classList.add('hover');}));
  ['dragleave','drop'].forEach(ev=>drop.addEventListener(ev,e=>{e.preventDefault();drop.classList.remove('hover');}));
  drop.addEventListener('drop',e=>apply([...e.dataTransfer.files]));
}
function dropLabel(list, leer){
  return list.length ? (list.length===1 ? list[0].name : `${list.length} Dateien ausgewählt`)
                     : (leer || 'Dateien hierher ziehen oder klicken');
}

/* Im Fenster-Programm (pywebview) laedt ein <a download> nicht herunter — die Datei
   liegt ohnehin schon im Ausgabe-Ordner. Darum dort "Im Ordner zeigen" anbieten. */
const isDesktop = () => !!window.pywebview;
function fileAction(link, label){
  const rel = String(link||'').replace(/^\/download\//,'');
  if(isDesktop())
    return `<span class="act" data-rev="${rel}">${icon('folder')}<span>${label||'Im Ordner'}</span></span>`;
  return `<a href="${link}">${icon('save')}<span>${label||'Speichern'}</span></a>`;
}
document.addEventListener('click', async e=>{
  const el = e.target.closest('[data-rev]');
  if(!el) return;
  e.preventDefault(); e.stopPropagation();
  try{
    await fetch('/api/reveal',{method:'POST',headers:{'Content-Type':'application/json'},
      body:JSON.stringify({file:el.dataset.rev})});
  }catch(err){}
});

function addRow(container, label){
  const row=document.createElement('div');
  row.className='res';
  row.innerHTML=`<div class="spin"></div><div class="name">${label}</div>`;
  container.appendChild(row);
  return row;
}
function setRow(row, ok, name, link){
  row.className='res '+(ok?'ok':'err');
  row.innerHTML = ok
    ? `${icon('check')}<div class="name">${name}</div>${fileAction(link)}`
    : `${icon('warn')}<div class="name">${name}</div>`;
  if(!ok){
    row.title='Klicken: Fehlermeldung kopieren';
    row.onclick=()=>copyText(row, name);
  } else { row.title=''; row.onclick=null; }
}
async function copyText(row, text){
  try{ await navigator.clipboard.writeText(text); }
  catch(e){
    const ta=document.createElement('textarea'); ta.value=text;
    ta.style.cssText='position:fixed;opacity:0';
    document.body.appendChild(ta); ta.select();
    try{ document.execCommand('copy'); }catch(_){}
    ta.remove();
  }
  if(row.querySelector('.copybadge')) return;
  const b=document.createElement('span'); b.className='copybadge'; b.textContent='Kopiert';
  row.appendChild(b);
  setTimeout(()=>b.remove(), 1600);
}

async function runFileBatch({files, btnSel, resSel, cntSel, endpoint, fill, verb}){
  if(!files.length) return;
  const res=$(resSel), cnt=$(cntSel), btn=$(btnSel);
  res.innerHTML=''; cnt.classList.remove('hidden'); btn.disabled=true;
  let done=0;
  for(const file of files){
    const row=addRow(res, file.name);
    cnt.textContent=`${verb} ${done+1} / ${files.length} …`;
    const fd=new FormData(); fd.append('file',file); fill(fd);
    try{
      const r=await fetch(endpoint,{method:'POST',body:fd});
      const d=await r.json();
      if(r.ok) setRow(row,true,d.file,d.download);
      else setRow(row,false,(d.error||'Fehler')+' — '+file.name);
    }catch(e){ setRow(row,false,e.message+' — '+file.name); }
    done++;
  }
  cnt.textContent=`Fertig: ${done} / ${files.length}`;
  btn.disabled=false;
  loadStats();
}

/* ===================== YouTube ===================== */
let ytFmt='mp3';
wirePills('#yt-formats', v=>ytFmt=v);

$('#yt-go').onclick = async ()=>{
  const links = $('#yt-url').value.split('\n').map(s=>s.trim()).filter(Boolean);
  const res=$('#yt-res'), cnt=$('#yt-count');
  res.innerHTML=''; cnt.classList.remove('hidden');
