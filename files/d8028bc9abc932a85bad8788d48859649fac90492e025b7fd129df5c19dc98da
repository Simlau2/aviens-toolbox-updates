  #intro .orbwrap{position:relative;width:min(34vmin,190px);aspect-ratio:1;margin-top:-6vh}
  #intro .orb{width:100%;height:100%;opacity:0;filter:drop-shadow(0 18px 30px rgba(0,40,110,.5));
    animation:intro-orb .95s cubic-bezier(.2,1.5,.35,1) .35s forwards,bob 3s ease-in-out 1.4s infinite}
  @keyframes intro-orb{0%{opacity:0;transform:translateY(60vh) scale(.3) rotate(-160deg)}
