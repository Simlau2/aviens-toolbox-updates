  .plist .tr .n{width:16px;flex:none;text-align:center;font-size:11px;color:var(--ink-3);font-variant-numeric:tabular-nums}
  .plist .tr .t{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .plist .tr .t small{display:block;font-size:10.5px;font-weight:400;color:var(--ink-3)}
