  /* Auftritt: Kopfzeile faellt ein, Kacheln und Karten steigen gestaffelt auf */
  .topbar{animation:drop-in .45s cubic-bezier(.2,.9,.3,1.2) backwards}
  .tile{animation:rise .5s cubic-bezier(.2,.9,.3,1.15) backwards;animation-delay:calc(var(--i,0)*45ms + 80ms)}
  .card:not(.hidden){animation:rise .42s cubic-bezier(.2,.9,.3,1.1) backwards}
  #home>.card{animation-delay:.5s}
  .toolbar:not(.hidden){animation:drop-in .35s ease backwards}
  .footer{animation:fade-in .6s .6s backwards}
  .player{animation:slide-up .55s .35s cubic-bezier(.2,.9,.3,1.15) backwards}
  .fl{animation:rise .35s ease backwards;animation-delay:calc(var(--i,0)*40ms)}
  .res{animation:rise .3s ease backwards}
  .res.err{animation:rise .3s ease backwards,shake .35s .3s}
  .plist:not(.hidden){animation:rise .22s cubic-bezier(.2,.9,.3,1.2) backwards;transform-origin:bottom right}
  #upd-box:not(.hidden),#lightbox:not(.hidden){animation:fade-in .2s ease backwards}
  #upd-box:not(.hidden) .card{animation:rise .35s cubic-bezier(.2,.9,.3,1.25) backwards}
  #lightbox:not(.hidden) img{animation:pop-in .3s cubic-bezier(.2,1.2,.4,1) backwards}

  /* Logo und Kachel-Symbole schweben leicht */
  .topbar img.logo{animation:bob 4.5s ease-in-out infinite}
  .topbar img.logo:hover{animation:wiggle .5s ease}
  .tile:hover img{animation:bob 1.6s ease-in-out infinite}
  .drop img{transition:transform .25s cubic-bezier(.2,1.4,.4,1)}
  .drop:hover img{transform:translateY(-4px) scale(1.08)}
  .drop.hover img{animation:bob .7s ease-in-out infinite}

  /* Glanz-Streifen, der beim Ueberfahren ueber Glas und Knoepfe laeuft */
  .tile,button.go,.ghost,.backbtn,.toggle,.pill.active,.pbtn.orb{overflow:hidden}
  .tile::after,button.go::after,.ghost::after,.backbtn::after,.toggle::after{
    content:"";position:absolute;top:0;bottom:0;left:0;width:34%;pointer-events:none;opacity:0;
    background:linear-gradient(90deg,transparent,rgba(255,255,255,.65),transparent);
    transform:translateX(-130%) skewX(-20deg);
  }
  button.go,.toggle,.ghost,.backbtn{position:relative}
  .tile:hover::after,button.go:not(:disabled):hover::after,.ghost:hover::after,.backbtn:hover::after,.toggle:hover::after{
    opacity:1;animation:sheen .75s ease}

  /* Knoepfe: federn beim Druecken, Symbole reagieren */
  button.go,.ghost,.backbtn,.toggle,.pill,.pbtn,.res a,.res .act{transition:transform .16s cubic-bezier(.2,1.6,.4,1),filter .15s,background .15s,color .15s,box-shadow .2s}
  button.go:not(:disabled):hover{transform:translateY(-1px)}
  button.go:not(:disabled):hover .ic{animation:wiggle .45s ease}
  .ghost:hover img,.ghost:hover .ic{animation:wiggle .45s ease}
  .backbtn:hover .ic{transform:translateX(-3px)}
  .backbtn .ic{transition:transform .2s cubic-bezier(.2,1.6,.4,1)}
  .toggle:hover{transform:translateY(-1px)}
  .toggle:hover .ic{transform:rotate(180deg)}
  .toggle .ic{transition:transform .5s cubic-bezier(.2,1,.3,1)}
  .pill:active{transform:scale(.94)}
  .pill.active{animation:pop-in .25s cubic-bezier(.2,1.5,.4,1)}
  .ghost.update:not(.hidden){animation:pulse-ring 1.8s ease-out infinite}
  .ghost.update .ic{animation:spin 3s linear infinite}

  /* Eingabefelder heben sich beim Fokus */
  input[type=text],textarea,select{transition:border-color .15s,box-shadow .2s,transform .2s,background .2s}
  input[type=text]:focus,textarea:focus,select:focus{transform:translateY(-1px);background:rgba(255,255,255,.8)}
  label{transition:color .15s}
  label:has(+ input:focus),label:has(+ textarea:focus),label:has(+ select:focus){color:var(--blue-deep)}

  /* Dateiliste und Ergebnisse */
  .fl{transition:padding-left .18s ease}
  .fl:hover{padding-left:6px}
  .fl img{transition:transform .2s cubic-bezier(.2,1.6,.4,1)}
  .fl:hover img{transform:scale(1.25) rotate(-6deg)}
  .res.ok>.ic{animation:pop-in .4s cubic-bezier(.2,1.8,.4,1) backwards}
  .res a:hover,.res .act:hover{transform:translateY(-1px)}

  /* Fortschrittsbalken: laufende Streifen */
  .bar>i{background-image:repeating-linear-gradient(-45deg,rgba(255,255,255,.35) 0 7px,transparent 7px 14px),
    linear-gradient(180deg,var(--leaf-hi) 0%,var(--leaf) 50%,var(--leaf-lo) 52%,var(--leaf) 100%);
    background-size:28px 100%,100% 100%;animation:stripes .8s linear infinite}

  /* Player: Cover dreht sich sanft mit, Orb pulsiert, Equalizer im aktuellen Titel */
  .player .cover{transition:transform .4s cubic-bezier(.2,1.2,.4,1),border-radius .4s}
  .player.playing .cover{animation:bob 2.4s ease-in-out infinite}
  .player .cover:hover{transform:scale(1.08) rotate(-4deg)}
  .player.playing .pbtn.orb{animation:pulse-ring 2s ease-out infinite}
  .pbtn:hover .ic{transform:scale(1.15)}
  .pbtn .ic{transition:transform .18s cubic-bezier(.2,1.6,.4,1)}
  .player .meta b{transition:opacity .25s,transform .25s}
  .player .meta.swap b,.player .meta.swap span{opacity:0;transform:translateY(6px)}
  .player .meta span{transition:opacity .25s .05s,transform .25s .05s}
  input[type=range]::-webkit-slider-thumb{transition:transform .15s cubic-bezier(.2,1.6,.4,1)}
  input[type=range]:hover::-webkit-slider-thumb{transform:scale(1.3)}
  .plist .tr{transition:background .15s,padding-left .15s}
  .plist .tr:hover{padding-left:14px}
  .eq{display:inline-flex;align-items:flex-end;gap:2px;width:16px;height:12px;flex:none;justify-content:center}
  .eq i{width:3px;height:100%;border-radius:2px;background:var(--leaf-lo);transform-origin:bottom;animation:eq .8s ease-in-out infinite}
  .eq i:nth-child(2){animation-delay:.25s}.eq i:nth-child(3){animation-delay:.5s}
  .player:not(.playing)~* .eq i,.paused .eq i{animation-play-state:paused}

  /* Klick-Welle auf Glas */
  .rip{position:absolute;width:40px;height:40px;margin:-20px 0 0 -20px;border-radius:50%;pointer-events:none;
    background:radial-gradient(circle,rgba(255,255,255,.75),rgba(255,255,255,0) 70%);animation:ripple .6s ease-out forwards}

  /* Galerie */
  .shot img{transition:transform .5s cubic-bezier(.2,1,.3,1)}
  .shot:hover img{transform:scale(1.04)}

  @media (prefers-reduced-motion:reduce){
