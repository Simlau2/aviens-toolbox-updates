  @keyframes intro-ring{0%{opacity:.9;transform:scale(.8)}100%{opacity:0;transform:scale(2.6)}}

  #intro h1{position:relative;margin:3vh 0 0;font-size:clamp(26px,6.4vmin,44px);font-weight:200;letter-spacing:.01em;
    color:#fff;text-shadow:0 2px 10px rgba(0,50,120,.55);white-space:nowrap;overflow:hidden}
  #intro h1 span{display:inline-block;opacity:0;animation:intro-letter .55s cubic-bezier(.2,1.4,.4,1) forwards;
