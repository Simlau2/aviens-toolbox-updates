}
function qrChanged(){ clearTimeout(qrTimer); qrTimer=setTimeout(qrPreview,250); }

$('#qr-text').addEventListener('input', qrChanged);
$('#qr-fg').addEventListener('input', qrChanged);
$('#qr-bg').addEventListener('input', qrChanged);
