<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Aviens Toolbox</title>
<script>
/* Start-Animation nur einmal pro Programmstart (nicht bei jedem Neuladen) */
(function(){try{
  /* ?intro=1 spielt sie erneut, ?intro=hold haelt sie an (zum Ansehen/Testen) */
  if((location.search.indexOf('intro=')>=0 || !sessionStorage.getItem('av_intro')) && !matchMedia('(prefers-reduced-motion: reduce)').matches)
    document.documentElement.classList.add('intro-on');
}catch(e){}})();
</script>
<style>
  /* =====================================================================
     Aviens Toolbox — Frutiger-Aero-Oberflaeche
     Himmel, Wasser, Glas und Glanz: ein Video-Hintergrund (Seedance-Loop),
     darauf glaenzende Glasflaechen. Alle Bilder und Symbole in
     static/ wurden mit Nano Banana erzeugt. Farbige Werkzeug-Symbole sind
     PNGs (tool-*.png), kleine Zeichen sind PNG-Masken (ic-*.png), die per
     CSS eingefaerbt werden.
     ===================================================================== */
  :root{
    color-scheme:light;
    --aqua:#19a9ef;                 /* Hauptfarbe: Aqua-Blau */
    --aqua-hi:#8fe6ff;
    --aqua-lo:#0672c9;
    --leaf:#5cc21f;                 /* Zweitfarbe: frisches Gruen */
    --leaf-hi:#c4f57a;
    --leaf-lo:#2e8f0e;
    --blue-deep:#0a6fc2;            /* Text/Zeichen auf hellem Glas */
    --blue-soft:rgba(60,170,240,.20);

    --wall:url(/static/wall-day.jpg);
    --bg:#5db8ee;
    --glass-a:rgba(255,255,255,.66);
    --glass-b:rgba(255,255,255,.30);
    --glass-strong:rgba(255,255,255,.78);
    --glass-line:rgba(255,255,255,.85);
    --gloss:rgba(255,255,255,.55);
    --inset:rgba(255,255,255,.55);
    --inset-2:rgba(20,90,150,.14);
    --ink:#0b2d4d;
    --ink-2:#3d5f7d;
    --ink-3:#6d8aa3;
    --on-wall:#ffffff;
    --on-wall-shadow:0 1px 3px rgba(0,50,100,.55);
    --hair:rgba(10,70,120,.18);
    --hair-soft:rgba(10,70,120,.10);
    --ok:#2f9a16;
    --err:#d8325e;

    --r-card:20px;
    --r-box:14px;
    --r-ctl:10px;
    --blur:blur(18px) saturate(1.5);
    --shadow:inset 0 1px 0 rgba(255,255,255,.9), 0 2px 4px rgba(0,50,100,.12), 0 16px 38px rgba(0,50,100,.25);
    --shadow-sm:inset 0 1px 0 rgba(255,255,255,.9), 0 1px 2px rgba(0,50,100,.14), 0 5px 14px rgba(0,50,100,.16);
    --focus:0 0 0 3px rgba(60,180,250,.5);
  }
  *{box-sizing:border-box}
  html,body{height:100%}
  body{
    margin:0;
    font-family:"Segoe UI","Frutiger","Myriad Pro","Helvetica Neue",-apple-system,BlinkMacSystemFont,system-ui,sans-serif;
    font-size:13.5px;line-height:1.45;color:var(--ink);background:var(--bg);
    -webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility;
    overscroll-behavior:none;cursor:default;
  }
  /* Hintergrund: Video-Loop, darunter das Standbild als Rueckfall */
  #bgvid{position:fixed;inset:0;width:100%;height:100%;object-fit:cover;z-index:-1;pointer-events:none;
    animation:fade-in 1.2s ease both}
  @media (prefers-reduced-motion:reduce){ #bgvid{display:none} }
  body::before{
    content:"";position:fixed;inset:0;z-index:-2;pointer-events:none;
    background:var(--wall) center/cover no-repeat;
  }
  body,button,select,.pills,.tile,.row-act{-webkit-user-select:none;user-select:none}
  input,textarea{-webkit-user-select:text;user-select:text}
  ::-webkit-scrollbar{width:12px;height:12px}
  ::-webkit-scrollbar-thumb{background:rgba(255,255,255,.55);border-radius:9px;border:3px solid transparent;background-clip:content-box}
  ::-webkit-scrollbar-thumb:hover{background:rgba(255,255,255,.8);background-clip:content-box}
  ::-webkit-scrollbar-track{background:transparent}

  .wrap{max-width:820px;margin:0 auto;padding:18px 20px 120px}

  /* ---------- Zeichen (PNG-Masken, per currentColor eingefaerbt) ---------- */
  .ic{
    display:inline-block;width:1em;height:1em;flex:none;vertical-align:-.14em;
    background-color:currentColor;
    -webkit-mask-image:var(--ic);mask-image:var(--ic);
    -webkit-mask-size:contain;mask-size:contain;
    -webkit-mask-repeat:no-repeat;mask-repeat:no-repeat;
    -webkit-mask-position:center;mask-position:center;
  }

  /* ---------- Glas-Grundstoff mit Glanzkante ---------- */
  .glass,.card,.tile,.topbar,.player,.plist{
    position:relative;
    background:linear-gradient(180deg,var(--glass-a),var(--glass-b));
    -webkit-backdrop-filter:var(--blur);backdrop-filter:var(--blur);
    border:1px solid var(--glass-line);
  }
  .card::before,.tile::before,.topbar::before,.player::before{
    content:"";position:absolute;left:1px;right:1px;top:1px;height:46%;pointer-events:none;
    border-radius:inherit;border-bottom-left-radius:50% 22%;border-bottom-right-radius:50% 22%;
    background:linear-gradient(180deg,var(--gloss),transparent);opacity:.75;
  }
  .card>*,.tile>*,.topbar>*,.player>*{position:relative}

  /* ---------- Kopfzeile ---------- */
  .topbar{display:flex;align-items:center;gap:12px;padding:10px 14px;margin-bottom:16px;
    border-radius:var(--r-card);box-shadow:var(--shadow-sm)}
  .topbar img.logo{width:46px;height:46px;flex:none;filter:drop-shadow(0 3px 6px rgba(0,50,100,.35))}
  .topbar h1{margin:0;font-size:19px;font-weight:300;letter-spacing:-.01em}
  .topbar p{margin:0;font-size:11.5px;color:var(--ink-2)}
  .topbar .sp{flex:1}

  .ghost,.backbtn{
    display:inline-flex;align-items:center;gap:6px;cursor:pointer;white-space:nowrap;
    padding:7px 14px;border-radius:999px;font-size:12.5px;font-weight:600;font-family:inherit;
    color:var(--ink);border:1px solid var(--glass-line);
    background:linear-gradient(180deg,var(--glass-strong) 0%,var(--glass-b) 50%,var(--glass-a) 100%);
    -webkit-backdrop-filter:var(--blur);backdrop-filter:var(--blur);
    box-shadow:var(--shadow-sm);transition:.12s;
  }
  .ghost:hover,.backbtn:hover{filter:brightness(1.08)}
  .ghost:active,.backbtn:active{transform:scale(.97)}
  .ghost .ic{font-size:14px;color:var(--blue-deep)}
  .ghost img{width:18px;height:18px}
  .ghost.update{color:#fff;border-color:rgba(255,255,255,.7);text-shadow:0 1px 1px rgba(20,80,0,.5);
    background:linear-gradient(180deg,var(--leaf-hi) 0%,var(--leaf) 50%,var(--leaf-lo) 52%,var(--leaf) 100%)}
  .ghost.update .ic{color:#fff}
  .vers{font-size:10.5px;color:var(--ink-3);font-variant-numeric:tabular-nums}

  /* ---------- Karten ---------- */
  .card{border-radius:var(--r-card);padding:18px 20px;box-shadow:var(--shadow);margin-bottom:14px}
  .card-head{display:flex;align-items:baseline;gap:10px;margin-bottom:12px}
  .card-head h2{margin:0;font-size:16px;font-weight:300;letter-spacing:-.01em}
  .card-head .sp{flex:1}
  .card-head .sub{font-size:11.5px;color:var(--ink-3)}

  /* ---------- Werkzeug-Kacheln ---------- */
  .tiles{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:14px}
  @media (max-width:700px){.tiles{grid-template-columns:repeat(2,1fr)}
    .tiles{gap:10px}.tile{padding:11px 12px;gap:10px}.tile img{width:42px;height:42px}
    .tile .nm{font-size:13px}.tile .ds{font-size:10.5px}
    .topbar p .vers{display:none}
    .gen-setup{flex-wrap:wrap}}
  .tile{
    border-radius:18px;padding:14px;cursor:pointer;box-shadow:var(--shadow-sm);
    display:flex;align-items:center;gap:12px;transition:.14s;
  }
  .tile:hover{transform:translateY(-2px);box-shadow:var(--shadow);filter:brightness(1.06)}
  .tile:active{transform:translateY(0) scale(.985)}
  .tile img{width:54px;height:54px;flex:none;filter:drop-shadow(0 4px 6px rgba(0,50,100,.35));transition:.18s}
  .tile:hover img{transform:scale(1.08) rotate(-3deg)}
  .tile .tx{min-width:0}
  .tile .nm{font-size:14px;font-weight:600;letter-spacing:-.01em}
  .tile .ds{font-size:11px;color:var(--ink-2);line-height:1.35;margin-top:1px}

  /* ---------- Letzte Dateien ---------- */
  .filelist{display:flex;flex-direction:column}
  .fl{display:flex;align-items:center;gap:10px;padding:8px 0;border-top:1px solid var(--hair-soft);cursor:pointer}
  .fl:first-child{border-top:0;padding-top:2px}
  .fl:hover .nm{color:var(--blue-deep)}
  .fl img{width:20px;height:20px;flex:none}
  .fl .nm{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:12.5px}
  .fl .mt{font-size:11px;color:var(--ink-3);font-variant-numeric:tabular-nums;flex:none}
  .empty{font-size:12px;color:var(--ink-3);padding:10px 0 4px}

  /* ---------- Werkzeug-Ansicht ---------- */
  .toolbar{display:flex;align-items:center;gap:12px;margin:2px 0 14px}
  .backbtn{padding:7px 14px 7px 10px}
  .backbtn .ic{font-size:11px;color:var(--blue-deep)}
  .tooltitle{display:flex;align-items:center;gap:9px;font-size:21px;font-weight:300;letter-spacing:-.01em;
    color:var(--on-wall);text-shadow:var(--on-wall-shadow)}
  .tooltitle img{width:34px;height:34px;filter:drop-shadow(0 2px 4px rgba(0,40,80,.45))}

  /* ---------- Formularelemente ---------- */
  label{display:block;font-size:11.5px;font-weight:600;color:var(--ink-2);margin:18px 0 7px}
  .card>label:first-child,.row label:first-child{margin-top:0}
  label .opt{font-weight:400;color:var(--ink-3)}
  input[type=text],textarea,select{
    width:100%;padding:9px 12px;border-radius:var(--r-ctl);font-size:13px;font-family:inherit;
    color:var(--ink);background:var(--inset);border:1px solid var(--hair);outline:none;
    box-shadow:inset 0 2px 4px rgba(0,50,100,.12);transition:.12s;
  }
  ::placeholder{color:var(--ink-3)}
  textarea{resize:vertical;min-height:82px;line-height:1.5}
  select{
    -webkit-appearance:none;appearance:none;padding-right:30px;cursor:pointer;
    background-image:linear-gradient(45deg,transparent 50%,var(--ink-2) 50%),
                     linear-gradient(135deg,var(--ink-2) 50%,transparent 50%);
    background-position:calc(100% - 15px) 15px,calc(100% - 11px) 15px;
    background-size:4px 4px,4px 4px;background-repeat:no-repeat;
  }
  select option{color:#0b2d4d;background:#fff}
  input:focus,textarea:focus,select:focus{border-color:var(--aqua);box-shadow:var(--focus)}
  .row{display:flex;gap:12px}.row>div{flex:1;min-width:0}
  .row+.row{margin-top:16px}

  input[type=color]{
    width:100%;height:38px;padding:3px;border-radius:var(--r-ctl);cursor:pointer;
    border:1px solid var(--hair);background:var(--inset);-webkit-appearance:none;appearance:none;
  }
  input[type=color]::-webkit-color-swatch-wrapper{padding:0}
  input[type=color]::-webkit-color-swatch{border-radius:7px;border:1px solid var(--hair)}
  input[type=color].dim{opacity:.3;pointer-events:none}

  /* Segmentierte Steuerung */
  .pills{display:flex;gap:2px;padding:2px;border-radius:999px;background:var(--inset-2);
    box-shadow:inset 0 1px 3px rgba(0,40,80,.18)}
  .pill{
    flex:1;display:flex;align-items:center;justify-content:center;gap:5px;
    padding:6px 10px;border-radius:999px;cursor:pointer;
    font-size:12.5px;font-weight:600;color:var(--ink-2);text-align:center;transition:.12s;
  }
  .pill:hover{color:var(--ink)}
  .pill.active{color:#fff;text-shadow:0 1px 1px rgba(0,50,110,.55);
    background:linear-gradient(180deg,var(--aqua-hi) 0%,var(--aqua) 50%,var(--aqua-lo) 52%,var(--aqua) 100%);
    box-shadow:inset 0 1px 0 rgba(255,255,255,.7),0 1px 3px rgba(0,60,120,.4)}
  .pills.small .pill{padding:4px 10px;font-size:11px}

  .hint{font-size:11px;color:var(--ink-3);margin-top:8px;line-height:1.5}
  .hint b{color:var(--ink-2);font-weight:600}

  /* Aktionsknopf: Aqua-Glanz */
  button.go{
    width:100%;margin-top:20px;padding:11px;border:1px solid rgba(255,255,255,.75);border-radius:999px;cursor:pointer;
    font-family:inherit;font-size:14px;font-weight:600;color:#fff;text-shadow:0 1px 2px rgba(0,50,110,.6);
    background:linear-gradient(180deg,var(--aqua-hi) 0%,var(--aqua) 48%,var(--aqua-lo) 52%,var(--aqua) 100%);
    box-shadow:inset 0 1px 0 rgba(255,255,255,.8),0 3px 6px rgba(0,60,120,.3),0 8px 20px rgba(20,150,240,.35);transition:.12s;
    display:flex;align-items:center;justify-content:center;gap:7px;
  }
  button.go.leaf{text-shadow:0 1px 2px rgba(20,80,0,.6);
    background:linear-gradient(180deg,var(--leaf-hi) 0%,var(--leaf) 48%,var(--leaf-lo) 52%,var(--leaf) 100%);
    box-shadow:inset 0 1px 0 rgba(255,255,255,.8),0 3px 6px rgba(20,80,0,.3),0 8px 20px rgba(90,190,30,.35)}
  button.go:hover{filter:brightness(1.07)}
  button.go:active{transform:scale(.99);filter:brightness(.95)}
  button.go:disabled{background:var(--inset-2);border-color:var(--hair);color:var(--ink-3);text-shadow:none;box-shadow:none;cursor:not-allowed}
  button.go .ic{font-size:15px}
  button.go.slim{width:auto;margin-top:0;padding:8px 18px;font-size:12.5px}

  /* Ablagefeld */
  .drop{
    border:1.5px dashed var(--hair);border-radius:var(--r-box);padding:22px 18px;text-align:center;
    color:var(--ink-2);font-size:12.5px;font-weight:600;cursor:pointer;background:var(--inset);
    transition:.14s;display:flex;flex-direction:column;align-items:center;gap:8px;
  }
  .drop img{width:40px;height:40px;filter:drop-shadow(0 3px 5px rgba(0,50,100,.3))}
  .drop:hover{filter:brightness(1.05)}
  .drop.hover{border-color:var(--aqua);background:var(--blue-soft);color:var(--blue-deep)}
  .drop.small{padding:12px;flex-direction:row;justify-content:center}
  .drop.small img{width:26px;height:26px}

  /* Ergebniszeilen */
  .results{margin-top:14px;display:flex;flex-direction:column;gap:7px}
  .res{
    display:flex;align-items:center;gap:10px;padding:9px 11px;border-radius:12px;font-size:12.5px;
    background:var(--inset);border:1px solid var(--hair-soft);
  }
  .res>.ic{font-size:15px;color:var(--ink-3)}
  .res.ok>.ic{color:var(--ok)}
  .res.err{background:rgba(216,50,94,.14);border-color:rgba(216,50,94,.3);cursor:pointer}
  .res.err>.ic{color:var(--err)}
  .res.err:hover{background:rgba(216,50,94,.2)}
  .res .name{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-weight:500}
  .res .name small{display:block;font-size:10.5px;color:var(--ink-3);font-weight:500;margin-top:1px}
  .res a,.res .act{
    flex:none;display:inline-flex;align-items:center;gap:5px;text-decoration:none;cursor:pointer;
    padding:5px 11px;border-radius:999px;font-size:11.5px;font-weight:600;color:var(--ink);
    background:linear-gradient(180deg,var(--glass-strong),var(--glass-b));
    border:1px solid var(--glass-line);box-shadow:var(--shadow-sm);transition:.12s;
  }
  .res a:hover,.res .act:hover{color:var(--blue-deep)}
  .res a .ic,.res .act .ic{font-size:12px;color:var(--blue-deep)}
  .copybadge{
    flex:none;padding:4px 9px;border-radius:999px;font-size:10.5px;font-weight:600;
    color:#fff;background:var(--aqua);white-space:nowrap;
    animation:pop-in .22s cubic-bezier(.2,1.4,.4,1) both;
  }
  .spin{width:14px;height:14px;border:2px solid var(--inset-2);border-top-color:var(--blue-deep);
    border-radius:50%;animation:spin .7s linear infinite;flex:none}
  @keyframes spin{to{transform:rotate(360deg)}}
  @keyframes pop-in{from{opacity:0;transform:scale(.6)}to{opacity:1;transform:scale(1)}}
  .hidden{display:none !important}
  .counter{font-size:11.5px;color:var(--ink-2);font-weight:600;margin-top:12px;font-variant-numeric:tabular-nums}
  .mono{font-family:Consolas,"SF Mono",ui-monospace,Menlo,monospace;font-size:12.5px}

  /* Fortschrittsbalken (Aero-Gruen) */
  .bar{height:12px;border-radius:999px;overflow:hidden;background:var(--inset-2);margin-top:12px;
    border:1px solid var(--hair);box-shadow:inset 0 1px 3px rgba(0,40,80,.25)}
  .bar>i{display:block;height:100%;width:0;border-radius:999px;transition:width .4s;
    background:linear-gradient(180deg,var(--leaf-hi) 0%,var(--leaf) 50%,var(--leaf-lo) 52%,var(--leaf) 100%)}

  /* Tanga Generator: Modell-Auswahl */
  .models{display:grid;grid-template-columns:repeat(2,1fr);gap:8px}
  .model{position:relative;padding:10px 12px;border-radius:var(--r-box);cursor:pointer;overflow:hidden;
    background:var(--inset);border:1px solid var(--hair);transition:transform .16s cubic-bezier(.2,1.6,.4,1),box-shadow .2s,border-color .15s,background .2s}
  .model:hover{transform:translateY(-1px);background:rgba(255,255,255,.75)}
  .model.active{border-color:var(--aqua);box-shadow:var(--focus);background:rgba(255,255,255,.85)}
  .model .top{display:flex;align-items:center;gap:6px}
  .model b{font-size:12.5px;font-weight:600;flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .model .tag{flex:none;padding:2px 7px;border-radius:999px;font-size:9.5px;font-weight:700;letter-spacing:.03em;
    color:#fff;text-shadow:0 1px 1px rgba(0,50,110,.5);
    background:linear-gradient(180deg,var(--aqua-hi),var(--aqua) 50%,var(--aqua-lo) 52%,var(--aqua))}
  .model.inst .tag{text-shadow:0 1px 1px rgba(20,80,0,.5);
    background:linear-gradient(180deg,var(--leaf-hi),var(--leaf) 50%,var(--leaf-lo) 52%,var(--leaf))}
  .model small{display:block;margin-top:3px;font-size:10.5px;color:var(--ink-2);line-height:1.35}
  .model .st{display:block;margin-top:4px;font-size:10px;color:var(--ink-3);font-variant-numeric:tabular-nums}
  .model.inst .st{color:var(--ok);font-weight:600}
  @media (max-width:460px){.models{grid-template-columns:1fr}}

  /* Tanga Generator */
  .gen-setup{display:flex;align-items:center;gap:14px;padding:14px;border-radius:var(--r-box);
    background:var(--inset);border:1px solid var(--hair-soft);margin-bottom:16px}
  .gen-setup img{width:48px;height:48px;flex:none}
  .gen-setup .tx{flex:1;min-width:0;font-size:12px;color:var(--ink-2);line-height:1.5}
  .gen-setup .tx b{display:block;font-size:13.5px;color:var(--ink);font-weight:600}
  .gallery{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin-top:14px}
  .gallery.one{grid-template-columns:1fr}
  .shot{position:relative;border-radius:var(--r-box);overflow:hidden;border:1px solid var(--glass-line);
    box-shadow:var(--shadow-sm);background:var(--inset);animation:pop-in .3s cubic-bezier(.2,1.2,.4,1) both}
  .shot img{display:block;width:100%;height:auto;cursor:zoom-in}
  .shot .ov{position:absolute;left:0;right:0;bottom:0;display:flex;align-items:center;gap:8px;padding:18px 10px 8px;
    background:linear-gradient(transparent,rgba(0,20,40,.7));color:#fff;font-size:11px;opacity:0;transition:.15s}
  .shot:hover .ov{opacity:1}
  .shot .ov .sp{flex:1}
  .shot .ov a,.shot .ov .act{display:inline-flex;align-items:center;gap:5px;cursor:pointer;color:#fff;text-decoration:none;
    padding:4px 10px;border-radius:999px;font-weight:600;background:rgba(255,255,255,.22);border:1px solid rgba(255,255,255,.5)}
  #lightbox{position:fixed;inset:0;z-index:90;display:flex;align-items:center;justify-content:center;
    background:rgba(0,15,30,.78);-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px);cursor:zoom-out}
  #lightbox img{max-width:94vw;max-height:92vh;border-radius:12px;box-shadow:0 20px 60px rgba(0,0,0,.6)}

  /* QR-Vorschau */
  .qr-prevbox{margin-top:18px;display:flex;justify-content:center}
  .qr-prev{
    width:200px;height:200px;border-radius:var(--r-box);display:flex;align-items:center;
    justify-content:center;overflow:hidden;border:1px solid var(--hair);
    background:
      linear-gradient(45deg,var(--inset-2) 25%,transparent 25%,transparent 75%,var(--inset-2) 75%),
      linear-gradient(45deg,var(--inset-2) 25%,transparent 25%,transparent 75%,var(--inset-2) 75%),
      var(--glass-strong);
    background-size:14px 14px;background-position:0 0,7px 7px;
  }
  .qr-prev img{width:100%;height:100%;object-fit:contain}
  .qr-prev .ph{font-size:11.5px;color:var(--ink-3);padding:16px;text-align:center;line-height:1.5}

  /* Farb-Werkzeuge */
  .fmtlabel{
    flex:none;width:54px;text-align:center;padding:3px 0;border-radius:999px;
    font-size:10px;font-weight:700;letter-spacing:.03em;color:var(--blue-deep);background:var(--blue-soft);
  }
  #col-swatch{height:54px;border-radius:var(--r-box);margin-top:12px;border:1px solid var(--hair);
    box-shadow:inset 0 14px 18px -8px rgba(255,255,255,.55)}
