  #intro .ring{position:absolute;inset:0;border-radius:50%;border:2px solid rgba(255,255,255,.85);opacity:0;
    animation:intro-ring 1.3s ease-out forwards}
  #intro .ring:nth-child(2){animation-delay:1.05s}
  #intro .ring:nth-child(3){animation-delay:1.3s}
