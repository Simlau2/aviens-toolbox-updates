  let d;
  try{
    const r=await fetch('/api/gen',{method:'POST',body:fd}); d=await r.json();
    if(!r.ok){ cnt.textContent=d.error||'Fehler'; return; }
  }catch(e){ cnt.textContent=e.message; return; }

  genJob=d.id; gal.innerHTML=''; gal.classList.toggle('one', genCount==='1');
  go.querySelector('span').textContent='Abbrechen'; go.classList.add('leaf');
  bar.classList.remove('hidden'); bar.firstElementChild.style.width='0%';
  let shown=0;
  while(true){
    await new Promise(r=>setTimeout(r,700));
    let st;
    try{ st=await (await fetch('/api/gen/job/'+genJob)).json(); }catch(e){ continue; }
    for(const f of (st.files||[]).slice(shown)){ gal.appendChild(genShot(f)); shown++; }
    bar.firstElementChild.style.width=st.progress+'%';
    if(st.phase==='fertig'){ cnt.textContent=`Fertig: ${shown} Bild${shown===1?'':'er'}`; break; }
    if(st.phase==='fehler'){ cnt.textContent=''; setRow(addRow(res,''),false,st.error||'Fehler'); break; }
    cnt.textContent=(GEN_PHASE[st.phase]||st.phase)+(st.phase==='bild'?` · ${st.progress} %`:'');
  }
  genJob=null; bar.classList.add('hidden');
  go.querySelector('span').textContent='Generieren'; go.classList.remove('leaf');
  loadStats();
};

/* ===================== Klick-Welle auf Glasflaechen ===================== */
document.addEventListener('pointerdown', e=>{
  const host = e.target.closest('.tile,button.go,.ghost,.backbtn,.toggle');
  if(!host || host.disabled) return;
  const r = host.getBoundingClientRect(), dot = document.createElement('span');
  dot.className='rip'; dot.style.left=(e.clientX-r.left)+'px'; dot.style.top=(e.clientY-r.top)+'px';
  host.appendChild(dot); setTimeout(()=>dot.remove(), 620);
});
window.genReady=true;
if(location.hash==='#gen') genRefresh();
</script>
