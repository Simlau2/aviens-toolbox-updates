let qrStyle='square', qrTransp=false, qrFmt='png', qrTimer=null;

function qrPayload(preview){
  return {text:$('#qr-text').value.trim(), fg:$('#qr-fg').value, bg:$('#qr-bg').value,
          transparent:qrTransp, style:qrStyle, format:qrFmt,
          size:parseInt($('#qr-size').value,10), preview:preview?1:0};
